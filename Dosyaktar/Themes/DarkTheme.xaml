<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- KOYU TEMA — Stitch Inspired Dark Theme -->
    <Color x:Key="BackgroundColor">#0b1326</Color>
    <Color x:Key="SurfaceColor">#131b2e</Color>
    <Color x:Key="Surface2Color">#171f33</Color>
    <Color x:Key="BorderColor">#2d3449</Color>
    <Color x:Key="AccentColor">#4d8eff</Color>
    <Color x:Key="AccentHoverColor">#571bc1</Color>
    <Color x:Key="DangerColor">#ffb4ab</Color>
    <Color x:Key="SuccessColor">#4edea3</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>

    <Color x:Key="TextPrimary">#dae2fd</Color>
    <Color x:Key="TextSecondary">#c2c6d6</Color>
    <Color x:Key="TextMuted">#8c909f</Color>
    
    <Color x:Key="TabBarColor">#171f33</Color>
    <Color x:Key="PeerCardHoverColor">#222a3d</Color>
    <Color x:Key="DropZoneHighlightColor">#1e293b</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TabBarBrush" Color="{StaticResource TabBarColor}"/>
    <SolidColorBrush x:Key="PeerCardHoverBrush" Color="{StaticResource PeerCardHoverColor}"/>
    <SolidColorBrush x:Key="DropZoneHighlightBrush" Color="{StaticResource DropZoneHighlightColor}"/>

    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#4edea3" Offset="0.0" />
        <GradientStop Color="#6ffbbe" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4d8eff" Offset="0.0" />
        <GradientStop Color="#571bc1" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
