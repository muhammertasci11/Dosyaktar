<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════════════════
         KOYU TEMA — Dark Theme
         ════════════════════════════════════════════════════════════════════ -->

    <Color x:Key="BackgroundColor">#0F1117</Color>
    <Color x:Key="SurfaceColor">#1A1D27</Color>
    <Color x:Key="Surface2Color">#22263A</Color>
    <Color x:Key="BorderColor">#2E3347</Color>
    <Color x:Key="AccentColor">#3B82F6</Color>
    <Color x:Key="AccentHoverColor">#2563EB</Color>
    <Color x:Key="DangerColor">#F87171</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FBBF24</Color>
    <Color x:Key="TextPrimary">#F1F5F9</Color>
    <Color x:Key="TextSecondary">#94A3B8</Color>
    <Color x:Key="TextMuted">#64748B</Color>
    <Color x:Key="TabBarColor">#13161F</Color>
    <Color x:Key="PeerCardHoverColor">#1E2540</Color>
    <Color x:Key="DropZoneHighlightColor">#1A2240</Color>

    <SolidColorBrush x:Key="BackgroundBrush"   Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush"     Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush"       Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"  Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="DangerBrush"       Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"      Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush"      Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"  Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecBrush"      Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush"    Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TabBarBrush"       Color="{StaticResource TabBarColor}"/>
    <SolidColorBrush x:Key="PeerCardHoverBrush" Color="{StaticResource PeerCardHoverColor}"/>
    <SolidColorBrush x:Key="DropZoneHighlightBrush" Color="{StaticResource DropZoneHighlightColor}"/>

</ResourceDictionary>
