<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- AÇIK TEMA — Stitch Inspired Light Theme -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="Surface2Color">#F1F5F9</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="AccentColor">#571bc1</Color>
    <Color x:Key="AccentHoverColor">#7c3aed</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="WarningColor">#D97706</Color>

    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>
    
    <Color x:Key="TabBarColor">#F8FAFC</Color>
    <Color x:Key="PeerCardHoverColor">#F1F5F9</Color>
    <Color x:Key="DropZoneHighlightColor">#EEF2FF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
    <SolidColorBrush x:Key="TabBarBrush" Color="{StaticResource TabBarColor}"/>
    <SolidColorBrush x:Key="PeerCardHoverBrush" Color="{StaticResource PeerCardHoverColor}"/>
    <SolidColorBrush x:Key="DropZoneHighlightBrush" Color="{StaticResource DropZoneHighlightColor}"/>

    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#059669" Offset="0.0" />
        <GradientStop Color="#10B981" Offset="1.0" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0.0" />
        <GradientStop Color="#6D28D9" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
