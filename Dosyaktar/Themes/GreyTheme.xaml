<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GRI TEMA — Sleek Gray Theme -->
    <Color x:Key="BackgroundColor">#1A1A1A</Color>
    <Color x:Key="SurfaceColor">#242424</Color>
    <Color x:Key="Surface2Color">#2E2E2E</Color>
    <Color x:Key="BorderColor">#404040</Color>
    <Color x:Key="AccentColor">#8E8E8E</Color>
    <Color x:Key="AccentHoverColor">#B0B0B0</Color>
    <Color x:Key="DangerColor">#E57373</Color>
    <Color x:Key="SuccessColor">#81C784</Color>
    <Color x:Key="WarningColor">#FFB74D</Color>

    <Color x:Key="TextPrimary">#E0E0E0</Color>
    <Color x:Key="TextSecondary">#A0A0A0</Color>
    <Color x:Key="TextMuted">#757575</Color>
    
    <Color x:Key="TabBarColor">#1E1E1E</Color>
    <Color x:Key="PeerCardHoverColor">#2D2D2D</Color>
    <Color x:Key="DropZoneHighlightColor">#333333</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="{StaticResource Surface2Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#404040" Offset="0.0"/>
        <GradientStop Color="#8E8E8E" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ProgressGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#8E8E8E" Offset="0.0"/>
        <GradientStop Color="#B0B0B0" Offset="1.0"/>
    </LinearGradientBrush>

</ResourceDictionary>
