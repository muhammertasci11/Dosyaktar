<Window x:Class="Dosyaktar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Dosyaktar.Views"
        Title="Dosyaktar"
        Width="1320" Height="860"
        MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ── peer card ─────────────────────────────────────────────── -->
        <DataTemplate x:Key="PeerCardTemplate">
            <Border Style="{StaticResource GlassCard}"
                    Width="286" Margin="0,0,14,14" Padding="16"
                    Cursor="Hand"
                    ToolTip="Cihaza bağlanmak için tıklayın">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="14"
                                Background="{DynamicResource PrimaryGradientBrush}">
                            <TextBlock Text="{Binding ConnectionIcon}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding IP}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PeerDot" Width="6" Height="6" VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Fill="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="PeerStatus" Text="{Binding StatusText}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="Gönder"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7"
                                FontSize="12"
                                Tag="{Binding}"
                                Click="BtnSendToPeer_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                    <Setter TargetName="PeerDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                    <Setter TargetName="PeerStatus" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── queue item ───────────────────────────────────────────── -->
        <DataTemplate x:Key="QueueItemTemplate">
            <Border CornerRadius="12" Padding="10,9" Margin="0,0,0,7"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            Tag="{Binding}" Click="BtnRemoveQueued_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── log item ─────────────────────────────────────────────── -->
        <DataTemplate x:Key="LogItemTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontSize="10"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,1,8,0"/>
                <TextBlock x:Name="LogText" Grid.Column="1" Text="{Binding Text}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecBrush}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="ok">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="warn">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="err">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── history item ─────────────────────────────────────────── -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <Border CornerRadius="14" Padding="14,12" Margin="0,0,0,9"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="12"
                            Background="{DynamicResource Surface2Brush}">
                        <TextBlock x:Name="HIcon" Text="{Binding Icon}"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding WhenText}"
                               FontSize="10.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="Received">
                    <Setter TargetName="HIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Success}" Value="False">
                    <Setter TargetName="HIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── mobile session ───────────────────────────────────────── -->
        <DataTemplate x:Key="MobileSessionTemplate">
            <Border CornerRadius="14" Padding="14,12" Margin="0,0,0,9"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="12"
                            Background="{DynamicResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Foreground="{DynamicResource SuccessInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SinceText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                            Content="Kes" FontSize="11" Padding="10,6"
                            Tag="{Binding}" Click="BtnDisconnectMobile_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── shared file ──────────────────────────────────────────── -->
        <DataTemplate x:Key="SharedFileTemplate">
            <Border CornerRadius="12" Padding="11,9" Margin="0,0,0,7"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource Accent2GlowBrush}">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            Tag="{Binding}" Click="BtnRemoveShared_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── setting row ──────────────────────────────────────────── -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Effect" Value="{x:Null}"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionText}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- ══════════════ ambient light field ══════════════ -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-320,-400,0,0" Fill="{DynamicResource AccentGlowBrush}"/>
            <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-260,-330" Fill="{DynamicResource Accent2GlowBrush}"/>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <!-- faceted prism logo -->
                    <Grid Width="26" Height="26" Margin="0,0,11,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="-8"/>
                        </Grid.RenderTransform>
                        <Path Fill="{DynamicResource PrismFace2Brush}" Opacity="0.85"
                              Data="M 13,2 L 24,8 L 24,18 L 13,24 L 2,18 L 2,8 Z"/>
                        <Path Fill="{DynamicResource PrismFace1Brush}"
                              Data="M 13,2 L 24,8 L 13,14 L 2,8 Z"/>
                        <Path Fill="{DynamicResource PrismFace3Brush}" Opacity="0.9"
                              Data="M 13,14 L 24,8 L 24,18 L 13,24 Z"/>
                    </Grid>

                    <TextBlock Text="Dosyaktar" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Style="{StaticResource ChipBadge}" Margin="9,0,0,0" Padding="7,2">
                        <TextBlock x:Name="TxtTitleVersion" Text="v2.1"
                                   FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentInkBrush}"/>
                    </Border>

                    <Border Width="1" Height="16" Background="{DynamicResource DividerBrush}" Margin="14,0"/>

                    <TextBlock x:Name="TxtPageTitle" Text="Keşif"
                               FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource ChipBadge}" Margin="0,0,10,0"
                            Padding="10,5" Background="{DynamicResource SuccessSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTitleNet" Text="LAN"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessInkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                            Click="BtnMinimize_Click" ToolTip="Küçült"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE922;"
                            Click="BtnMaximize_Click" ToolTip="Büyüt" Margin="2,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="BtnCloseWindow_Click" Foreground="{DynamicResource DangerInkBrush}"
                            ToolTip="Kapat"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════ BODY ══════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*" MinWidth="440"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- ════ PAGE: OYUNLAR (tam genişlik: sağ panel gizlenir) ════ -->
                <Grid x:Name="PageGames"
                      Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="14,0,10,10"
                      Visibility="Collapsed">
                    <views:GameLibraryView x:Name="GamesView"/>
                </Grid>

                <!-- ─────────── icon rail ─────────── -->
                <Border Grid.Column="0" Margin="10,0,0,10"
                        Background="{DynamicResource GlassBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,16,0,10" HorizontalAlignment="Center">
                            <Border Width="38" Height="3" CornerRadius="2"
                                    Background="{DynamicResource PrimaryGradientBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="9,4" VerticalAlignment="Top">
                            <RadioButton x:Name="RbSend" GroupName="nav" IsChecked="True"
                                         Content="Keşif" Tag="&#xE721;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="RbSession" GroupName="nav"
                                         Content="Oturum" Tag="&#xE71B;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="RbGames" GroupName="nav"
                                         Content="Oyunlar" Tag="&#xE7FC;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="RbMobile" GroupName="nav"
                                         Content="Mobil" Tag="&#xE8EA;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="RbHistory" GroupName="nav"
                                         Content="Geçmiş" Tag="&#xE81C;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <RadioButton x:Name="RbSettings" GroupName="nav"
                                         Content="Ayarlar" Tag="&#xE713;"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="9,0,9,12">
                            <Button Style="{StaticResource IconButton}" Content="&#xE790;"
                                    Width="Auto" Height="34" FontSize="16"
                                    Click="BtnThemeCycle_Click" ToolTip="Temayı değiştir"/>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,8"/>
                            <Border Width="34" Height="34" CornerRadius="11"
                                    Background="{DynamicResource PrimaryGradientBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtAvatar" Text="D"
                                           Foreground="White" FontSize="14" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─────────── main content ─────────── -->
                <Grid Grid.Column="1" Margin="14,0,0,10">

                    <!-- ════ PAGE: KEŞİF ════ -->
                    <Grid x:Name="PageSend">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="6,6,6,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Yakındaki cihazlar" Style="{StaticResource DisplayText}" FontSize="25"/>
                                <TextBlock x:Name="TxtPeerSubtitle" Text="Aynı ağdaki cihazlar aranıyor…"
                                           Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource SecondaryButton}" Content="Oyunlar"
                                        Padding="14,9" Margin="0,0,8,0" Click="BtnGameTransfer_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                        Width="38" Height="38" Click="BtnRefresh_Click" ToolTip="Yenile"/>
                            </StackPanel>
                        </Grid>

                        <!-- peer strip -->
                        <Border Grid.Row="1" Margin="0,0,0,14">
                            <Grid>
                                <ScrollViewer x:Name="PeerScroll" VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Auto" Padding="0,0,0,4">
                                    <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border x:Name="EmptyPeers" CornerRadius="20" Padding="26"
                                        Background="{DynamicResource GlassBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid Width="44" Height="44" Margin="0,0,16,0">
                                            <Ellipse x:Name="ScanRing" Width="44" Height="44"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                                     Opacity="0.35"/>
                                            <Ellipse Width="26" Height="26"
                                                     Fill="{DynamicResource AccentSoftBrush}"/>
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cihaz aranıyor" Style="{StaticResource SectionText}"/>
                                            <TextBlock Text="Karşı tarafta Dosyaktar açık olmalı ve iki cihaz aynı ağda olmalı."
                                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- drop zone -->
                        <Border Grid.Row="2" x:Name="DropZone" CornerRadius="24" Margin="0,0,0,2"
                                AllowDrop="True"
                                Background="{DynamicResource GlassBrush}"
                                BorderThickness="1.5" Padding="30"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop"
                                MouseDown="DropZone_MouseDown"
                                Cursor="Hand">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource BorderStrongColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0.5"/>
                                    <GradientStop Color="{DynamicResource BorderStrongColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>

                            <Grid>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="66" Height="66" CornerRadius="20"
                                            Background="{DynamicResource PrimaryGradientBrush}"
                                            HorizontalAlignment="Center"
                                            Effect="{DynamicResource AccentShadow}">
                                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="26" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="Dosyaları buraya bırak" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="19" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,18,0,4"/>
                                    <TextBlock x:Name="TxtDropHint"
                                               Text="Klasör, oyun veya 50 GB'lık tek dosya — hepsi olur."
                                               Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" MaxWidth="440"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button Content="Dosya seç" Style="{StaticResource PrimaryButton}"
                                                Padding="20,11" Click="BtnPickFiles_Click"/>
                                        <Button Content="Klasör seç" Style="{StaticResource SecondaryButton}"
                                                Padding="18,11" Margin="9,0,0,0" Click="BtnPickFolder_Click"/>
                                    </StackPanel>

                                    <Border x:Name="SelectedTargetBar" Visibility="Collapsed"
                                            CornerRadius="12" Padding="12,8" Margin="0,18,0,0"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE727;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="{DynamicResource AccentInkBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Hedef:" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTargetName" FontSize="11.5" FontWeight="SemiBold"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTargetIp" FontSize="11.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    Width="22" Height="22" FontSize="9" Margin="8,0,0,0"
                                                    Click="BtnClearTarget_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ════ PAGE: OTURUM ════ -->
                    <Grid x:Name="PageSession" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,6,6,0">
                                <TextBlock Text="Aktif oturum" Style="{StaticResource DisplayText}" FontSize="25"/>
                                <TextBlock Text="Eşleşen cihazla canlı bağlantı."
                                           Style="{StaticResource MutedText}" Margin="0,3,0,20"/>

                                <!-- connected card -->
                                <Border x:Name="SessionActive" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="54" Height="54" CornerRadius="16"
                                                    Background="{DynamicResource PrimaryGradientBrush}">
                                                <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="22" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSessName" Text="Cihaz"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtSessIp" Text="—" Style="{StaticResource MutedText}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ChipBadge}"
                                                        Background="{DynamicResource SuccessSoftBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Bağlı" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessInkBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="OTURUM" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessSince" Text="—" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="PORT" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessPort" Text="5001" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="MOD" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessMode" Text="Standart" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}"/>

                                        <TextBlock x:Name="TxtSessionPercent" Text="Hazır"
                                                   Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                                        <ProgressBar x:Name="PbSession" Style="{StaticResource ModernProgress}" Value="0"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtSessionSpeed" Text="—" Style="{StaticResource MutedText}"/>
                                            <TextBlock x:Name="TxtSessionEta" Text="" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button Content="Dosya gönder" Style="{StaticResource PrimaryButton}"
                                                    Click="BtnSessionSendFiles_Click"/>
                                            <Button Content="Klasör gönder" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnSessionSendFolder_Click"/>
                                            <Button x:Name="BtnReceiveToggle" Content="Almayı durdur"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="9,0,0,0" Click="BtnReceiveToggle_Click"/>
                                            <Button Content="Bağlantıyı kes" Style="{StaticResource GhostButton}"
                                                    Margin="16,0,0,0"
                                                    Click="BtnDisconnect_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- not connected -->
                                <Border x:Name="SessionEmpty" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Text="Henüz bir cihaza bağlı değilsin"
                                                   Style="{StaticResource SectionText}" FontSize="16"/>
                                        <TextBlock Text="Keşif sekmesinden bir cihaz seç ya da karşı ekranda beliren PIN'i buraya gir."
                                                   Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

                                        <TextBlock Text="PIN ile eşleş" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="TxtPairPin" Style="{StaticResource ModernTextBox}"
                                                     Width="170" MaxLength="6" FontSize="20"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Tag="000000" VerticalContentAlignment="Center"/>
                                            <Button Content="Eşleş" Style="{StaticResource PrimaryButton}"
                                                    Margin="9,0,0,0" Click="BtnPairWithPin_Click"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,20"/>

                                        <TextBlock Text="IP ile doğrudan bağlan" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="TxtManualIp" Style="{StaticResource ModernTextBox}"
                                                     Width="200" Tag="192.168.1.24"/>
                                            <Button Content="Bağlan" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnManualConnect_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: MOBİL ════ -->
                    <Grid x:Name="PageMobile" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,6,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Mobil köprü" Style="{StaticResource DisplayText}" FontSize="25"/>
                                        <TextBlock Text="Telefonun tarayıcısından gönder ve al — uygulama kurmadan."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnToggleBridge" Content="Köprüyü kapat"
                                                Style="{StaticResource SecondaryButton}" Click="BtnToggleBridge_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- QR -->
                                    <Border Style="{StaticResource GlassCard}" Width="266">
                                        <StackPanel>
                                            <Border CornerRadius="16" Padding="12"
                                                    Background="White" HorizontalAlignment="Center">
                                                <Image x:Name="ImgQr" Width="196" Height="196"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>

                                            <TextBlock Text="Telefonla tara" Style="{StaticResource SectionText}"
                                                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                                            <TextBlock x:Name="TxtMobileUrl" Text="http://—"
                                                       Style="{StaticResource MonoText}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="Adresi kopyala" Style="{StaticResource GhostButton}"
                                                    Margin="0,6,0,0" Click="BtnCopyUrl_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PIN + sessions -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Bağlantı kodu" Style="{StaticResource EyebrowText}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Ellipse Width="7" Height="7" x:Name="BridgeDot"
                                                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TxtBridgeState" Text="Yayında"
                                                                   FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessInkBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Name="TxtMobilePin" Text="000 000"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="38" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock x:Name="TxtMobileIp" Text="—"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button Content="Yeni kod" Style="{StaticResource SecondaryButton}"
                                                            Padding="14,9" Click="BtnNewPin_Click"/>
                                                    <Button Content="IP'yi kopyala" Style="{StaticResource GhostButton}"
                                                            Padding="12,9" Margin="6,0,0,0" Click="BtnCopyIp_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource GlassCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="Bağlı telefonlar" Style="{StaticResource SectionText}"/>
                                                    <TextBlock x:Name="TxtMobileCount" Text="0"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentInkBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl x:Name="MobileSessionsList"
                                                              ItemTemplate="{StaticResource MobileSessionTemplate}"/>

                                                <TextBlock x:Name="EmptyMobileSessions"
                                                           Text="Henüz telefon bağlanmadı. QR'ı okutman yeterli."
                                                           Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- shared files -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,16,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Telefona açılan dosyalar" Style="{StaticResource SectionText}"/>
                                                <TextBlock Text="Buraya eklediğin dosyalar telefonun 'Al' sekmesinde görünür."
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSharedCount" Text="0 dosya"
                                                           Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="Dosya ekle" Style="{StaticResource PrimaryButton}"
                                                        Padding="16,9" Click="BtnAddShared_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl x:Name="SharedFilesList"
                                                      ItemTemplate="{StaticResource SharedFileTemplate}"/>
                                        <TextBlock x:Name="EmptyShared"
                                                   Text="Henüz dosya paylaşmadın."
                                                   Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: GEÇMİŞ ════ -->
                    <Grid x:Name="PageHistory" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel Margin="6,6,6,0">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Transfer geçmişi" Style="{StaticResource DisplayText}" FontSize="25"/>
                                        <TextBlock Text="Son 250 aktarım, cihazında saklanır."
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnClearHistory" Style="{StaticResource SecondaryButton}"
                                            Content="Geçmişi temizle"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Click="BtnClearHistory_Click"/>
                                </Grid>

                                <Grid>
                                    <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItemTemplate}"/>

                                    <Border x:Name="EmptyHistory" Style="{StaticResource GlassCard}" MinHeight="380">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                            <Border Width="62" Height="62" CornerRadius="20"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="26" Foreground="{DynamicResource AccentInkBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Henüz aktarım yok" Style="{StaticResource SectionText}"
                                                       HorizontalAlignment="Center" Margin="0,16,0,3"/>
                                            <TextBlock Text="İlk dosyanı gönderdiğinde burada görünecek."
                                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: AYARLAR ════ -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel Margin="6,6,6,0">
                                <TextBlock Text="Ayarlar" Style="{StaticResource DisplayText}" FontSize="25"/>
                                <TextBlock Text="Görünüm, ağ ve aktarım davranışı."
                                           Style="{StaticResource MutedText}" Margin="0,3,0,16"/>

                                <!-- themes -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Tema" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="Seçim anında uygulanır ve hatırlanır."
                                                           Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtActiveTheme" Text="Prism"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentInkBrush}"/>
                                        </Grid>

                                        <WrapPanel x:Name="ThemeGallery"/>
                                    </StackPanel>
                                </Border>

                                <!-- network -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Ağ" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Cihaz adı" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtHostname" Style="{StaticResource ModernTextBox}"
                                                         LostFocus="Setting_Changed"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Aktarım portu" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtPort" Style="{StaticResource ModernTextBox}"
                                                         LostFocus="Setting_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,18,0,14"/>

                                        <CheckBox x:Name="ChkAutoReceive" Style="{StaticResource ToggleSwitch}"
                                                  Content="Otomatik alma modu — gelen aktarımları sormadan kabul et"
                                                  Click="Setting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- storage -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Kayıt yeri" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtDownloadFolder" Style="{StaticResource ModernTextBox}"
                                                     LostFocus="Setting_Changed"/>
                                            <Button Grid.Column="1" Content="Gözat" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnBrowseFolder_Click"/>
                                        </Grid>

                                        <Button Content="Klasörü aç" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Click="BtnOpenDownloadFolder_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- transfer -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Aktarım" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <CheckBox x:Name="ChkFlashMode" Style="{StaticResource ToggleSwitch}"
                                                  Content="Flash modu — dosyayı paralel kanallara böl"
                                                  Click="Setting_Changed"/>

                                        <StackPanel Margin="0,18,0,0">
                                            <Grid>
                                                <TextBlock Text="Paralel kanal sayısı" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="TxtFlashConns" Text="8"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}"/>
                                            </Grid>
                                            <Slider x:Name="SliFlashConns" Style="{StaticResource ModernSlider}"
                                                    Minimum="2" Maximum="32" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" Value="8"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="SliFlashConns_ValueChanged"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,14,0,14"/>

                                        <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource ToggleSwitch}"
                                                  Content="Açılışta güncellemeleri kontrol et"
                                                  Click="Setting_Changed"/>
                                        <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitch}"
                                                  Content="Yeni sürümü arka planda indir"
                                                  Margin="0,14,0,0" Click="Setting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- about -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="Uygulama" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <StackPanel>
                                                <TextBlock x:Name="TxtAppVersion" Text="Dosyaktar v2.1.0"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text=".NET 8 · WPF · tek dosya"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Content="Güncellemeleri kontrol et"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="BtnCheckUpdates_Click"/>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,16,0,14"/>

                                        <Button Content="Uygulama verilerini sıfırla"
                                                Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Left"
                                                Click="BtnResetApp_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ─────────── right panel ─────────── -->
                <Grid x:Name="RailRight" Grid.Column="2" Margin="0,0,10,10">
                    <Border Background="{DynamicResource GlassBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="22" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- active transfer -->
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Aktarım" Style="{StaticResource SectionText}"/>
                                    <Border Style="{StaticResource ChipBadge}" HorizontalAlignment="Right"
                                            Padding="7,2" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock x:Name="TxtQueueCount" Text="0"
                                                   FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentInkBrush}"/>
                                    </Border>
                                </Grid>

                                <Border x:Name="ActiveTransferCard" Visibility="Collapsed"
                                        CornerRadius="14" Padding="14,12"
                                        Background="{DynamicResource GlassStrongBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtActiveName" Text="—"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtActiveDetail" Text=""
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5" Margin="0,2,0,9"/>
                                        <ProgressBar x:Name="PbActive" Style="{StaticResource ModernProgress}" Height="8"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBlock x:Name="TxtActiveSpeed" Text=""
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessInkBrush}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtActivePercent" Text="0%"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnCancelTransfer" Style="{StaticResource IconButton}"
                                                        Content="&#xE711;" Width="22" Height="22" FontSize="9"
                                                        Click="BtnCancelTransfer_Click" ToolTip="İptal"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Kuyruk" Style="{StaticResource EyebrowText}" Margin="2,16,0,8"/>
                            </StackPanel>

                            <!-- queue list -->
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueItemTemplate}"/>
                                </ScrollViewer>

                                <TextBlock x:Name="EmptyQueue" Text="Kuyruk boş. Göndermek için dosya ekle."
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- activity log -->
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Border Style="{StaticResource DividerLine}" Margin="0,0,0,10"/>
                                <Grid Margin="2,0,0,7">
                                    <TextBlock Text="Etkinlik" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock x:Name="TxtStatusNet" Text="—"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" FontSize="10"/>
                                </Grid>
                                <ScrollViewer x:Name="LogScroll" MaxHeight="170"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogItemTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Hazır" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusMobile" Text="Mobil köprü: kapalı"
                                   FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Border Width="1" Height="12" Background="{DynamicResource DividerBrush}" Margin="12,0"/>
                        <TextBlock x:Name="TxtStatusVersion" Text="v2.1.0"
                                   FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════ PAIRING OVERLAY ══════════════════════ -->
        <Grid x:Name="PairingOverlay" Visibility="Collapsed"
              Background="{DynamicResource OverlayBrush}">
            <Border Style="{StaticResource GlassCard}" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="18"
                            Background="{DynamicResource PrimaryGradientBrush}"
                            HorizontalAlignment="Center"
                            Effect="{DynamicResource AccentShadow}">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}"
                                   FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Eşleşme isteği" Style="{StaticResource DisplayText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock x:Name="TxtPairingHost" Text="Cihaz"
                               Style="{StaticResource SectionText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPairingIp" Text="—"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                    <Border CornerRadius="14" Padding="16" Margin="0,18,0,0"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="TxtPairingPin" Text="000 000"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentInkBrush}"/>
                    </Border>

                    <TextBlock x:Name="TxtPairingHint" Text="Kod iki cihazda da aynıysa kabul edin."
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <Grid x:Name="PairingActions" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Reddet" Style="{StaticResource DangerButton}"
                                Margin="0,0,5,0" Click="BtnPairingReject_Click"/>
                        <Button Grid.Column="1" Content="Kabul et" Style="{StaticResource PrimaryButton}"
                                Margin="5,0,0,0" Click="BtnPairingAccept_Click"/>
                    </Grid>

                    <Button x:Name="BtnPairingCancel" Content="İptal" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="BtnPairingCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════ DROP OVERLAY ══════════════════════ -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
              Background="{DynamicResource AccentGhostBrush}">
            <Border CornerRadius="26" Margin="90,70" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource GlassStrongBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}"
                               FontSize="42" Foreground="{DynamicResource AccentInkBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Bırak, gerisini biz hallederiz"
                               Style="{StaticResource DisplayText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
