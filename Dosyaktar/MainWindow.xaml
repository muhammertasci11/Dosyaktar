<Window x:Class="Dosyaktar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dosyaktar" Height="750" Width="1100"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Icon="Assets/icon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Modern ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
        </Style>
        
        <!-- ToggleButton for Dosya Gönder / Al -->
        <Style x:Key="ModernTabButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="20" Padding="16,8" Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" Padding="12,12" Margin="16,4" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI Emoji" Margin="0,0,12,0" FontSize="16" Foreground="{DynamicResource TextSecBrush}"/>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource TextSecBrush}" FontWeight="Medium" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Peer Card Style -->
        <DataTemplate x:Key="PeerCardTemplate">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,16,0" Width="220" Cursor="Hand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Width="36" Height="36" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Margin="0,0,12,0">
                            <TextBlock Text="💻" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Müsait • PC" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <Ellipse Grid.Column="2" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="{Binding IpAddress}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,0,0,16"/>

                    <Button Grid.Row="2" Content="▷ Bağlan" Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextSecBrush}" BorderThickness="0" Height="32" Tag="{Binding}" Click="BtnSendToPeer_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        
        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Success Button Style -->
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/> <!-- Darker Green -->
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Custom Title Bar ═══ -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0">
                    <Image Source="Assets/icon.png" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Dosyaktar" Foreground="{DynamicResource TextSecBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="—" Style="{StaticResource WindowControlBtn}" Click="BtnMinimize_Click"/>
                    <Button Content="☐" Style="{StaticResource WindowControlBtn}" Click="BtnMaximize_Click"/>
                    <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Click="BtnCloseWindow_Click"/>
                </StackPanel>
            </Grid>

            <!-- ═══ Main Content Area ═══ -->
            <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" /> <!-- Sidebar -->
            <ColumnDefinition Width="*" />   <!-- Main Area -->
            <ColumnDefinition Width="340" /> <!-- Queue -->
        </Grid.ColumnDefinitions>

        <!-- ═══ 1. LEFT SIDEBAR ═══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Orientation="Horizontal" Margin="24,32,24,40">
                    <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="10" Margin="0,0,12,0">
                        <TextBlock Text="⇄" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dosyaktar" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{DynamicResource Text_AppSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="BtnNavDiscovery" Content="{DynamicResource Text_NavDiscovery}" Tag="🧭" Style="{DynamicResource SidebarButton}" IsChecked="True" Checked="BtnNav_Checked"/>
                    <RadioButton x:Name="BtnNavActive" Content="{DynamicResource Text_NavActive}" Tag="⇄" Style="{DynamicResource SidebarButton}" Checked="BtnNav_Checked"/>
                    <RadioButton x:Name="BtnNavHistory" Content="{DynamicResource Text_NavHistory}" Tag="🕒" Style="{DynamicResource SidebarButton}" Checked="BtnNav_Checked"/>
                    <RadioButton Content="{DynamicResource Text_NavGames}" Tag="🎮" Style="{DynamicResource SidebarButton}" Click="BtnGameTransfer_Click"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel Grid.Row="2" Margin="16,24">
                    <Button x:Name="BtnSettings" Background="Transparent" Foreground="{DynamicResource TextSecBrush}" BorderThickness="0" HorizontalAlignment="Left" Padding="12" Click="BtnSettings_Click" Cursor="Hand" FontSize="14" FontWeight="Medium">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙ "/>
                            <TextBlock Text="{DynamicResource Text_Settings}"/>
                        </StackPanel>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="{DynamicResource Text_PairDevice}" Foreground="White" FontWeight="Bold" FontSize="12" Margin="0,16,0,0" Height="40" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource PairDeviceGradientBrush}" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. MAIN AREA ══════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1" Margin="40">
            <!-- 2.A: Discovery Panel -->
            <Grid x:Name="PanelDiscovery" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Text_NearbyDevices}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scanning local network..." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="⟳ Refresh List" Style="{StaticResource SecondaryButton}" Padding="16,10" FontSize="12" Click="BtnRefresh_Click"/>
                </Grid>

                <!-- Radar Animation Area -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Height="260" Margin="0,0,0,32">
                    <Grid>
                        <!-- Radar Circles -->
                        <Ellipse Width="80" Height="80" Stroke="{DynamicResource Surface2Brush}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="160" Height="160" Stroke="{DynamicResource Surface2Brush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                        <Ellipse Width="240" Height="240" Stroke="{DynamicResource Surface2Brush}" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.2"/>
                        
                        <Border Width="48" Height="48" Background="{DynamicResource Surface2Brush}" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🎯" FontSize="20" Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Network Info -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16">
                            <TextBlock Text="📶" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Network: AURA_SECURE" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 2.B: Active Transfers Panel (SHAREIT SESSION MODE) -->
            <Grid x:Name="PanelActive" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header & Disconnect -->
                    <RowDefinition Height="*"/>    <!-- 2 Column Layout -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Oturum Aktif" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Cihazlar eşleşti. Dosya veya oyun göndermek için sürükleyip bırakabilirsiniz." FontSize="14" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>
                    <Button Content="Bağlantıyı Kes" Style="{StaticResource DangerButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="16,8" Height="36" Click="BtnDisconnect_Click"/>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: My Device -->
                    <Border Grid.Column="0" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="16" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave" Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="64" Background="{DynamicResource Surface2Brush}" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <TextBlock Text="💻" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding ElementName=TxtHostname, Path=Text}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Bu Cihaz" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                            
                            <Border x:Name="DropZoneBorder" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                                <StackPanel>
                                    <TextBlock Text="Göndermek için dosyaları buraya sürükleyin" Foreground="{DynamicResource TextSecBrush}" FontSize="12" TextAlignment="Center" Margin="0,0,0,8"/>
                                    <Button Content="Dosya Seç" Height="32" Click="BtnBrowse_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Button Content="Oyun Gönder" Background="Transparent" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" Click="BtnGameTransfer_Click" Cursor="Hand" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>

                    <!-- Center: Arrow -->
                    <TextBlock Grid.Column="1" Text="⇄" FontSize="28" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Right: Target Device -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="64" Height="64" Background="{DynamicResource Surface2Brush}" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <TextBlock Text="📱" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtActiveTargetName" Text="Hedef Cihaz" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtActiveTargetIP" Text="192.168.x.x" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                            
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="16,12" HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="Karşı cihaz şu an otomatik alım modunda." Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Bağlantı Stabil" Foreground="{DynamicResource TextSecBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- 2.C: History Panel -->
            <Grid x:Name="PanelHistory" Visibility="Collapsed">
                <StackPanel x:Name="HistoryList" Margin="0,0,0,32">
                    <TextBlock Text="{DynamicResource Text_HistoryTitle}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="{DynamicResource Text_HistoryDesc}" FontSize="14" Foreground="{DynamicResource TextSecBrush}" Margin="0,0,0,16"/>
                </StackPanel>
                <TextBlock x:Name="TxtHistoryEmpty" Text="{DynamicResource Text_HistoryEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>
        </Grid>

        <!-- ═══ 3. RIGHT SIDEBAR (QUEUE) ══════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid Margin="24,32,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/> <!-- Bottom Actions if needed -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{DynamicResource Text_QueueTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtActiveCount" Text="{DynamicResource Text_ActiveCount}" FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Tek bir Aktarım Kartı Örneği -->
                        <Border x:Name="TransferCard" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Margin="0,0,12,0">
                                        <TextBlock Text="📄" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTransferFile" Text="Bekleniyor..." Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                        <TextBlock x:Name="TxtTargetDevice" Text="Bekleniyor" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCancel" Grid.Column="2" Content="✕" Foreground="{DynamicResource TextMutedBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click" VerticalAlignment="Top">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}" FontSize="14"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtSizeInfo" Text="0 MB / 0 MB" FontSize="11" Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtSpeed" Text="0 MB/s" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar x:Name="PbTransfer" Grid.Row="2" Height="4" Value="0" Maximum="100" BorderThickness="0" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource ProgressGradientBrush}" Margin="0,0,0,8"/>
                                
                                <TextBlock x:Name="TxtRemaining" Grid.Row="3" Text="~0s remaining" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
        
        <!-- ═══ 4. LEGACY CONTROLS (HIDDEN) ════════════════════════════════════════ -->
        <!-- Code-behind derlemesinin patlamaması için eski kontrolleri gizleyerek tutuyoruz -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="TxtConnStatus" />
            <TextBlock x:Name="TxtScanning" />
            <TextBlock x:Name="TxtMyIP" />
            <TextBlock x:Name="TxtNetStatus" />
            <TextBlock x:Name="TxtTargetLabel" />
            <TextBlock x:Name="DropHint" />
            <TextBlock x:Name="TxtPercent" />
            <TextBlock x:Name="TxtStatus" />
            <TextBlock x:Name="TxtLog" />
            <TextBlock x:Name="TxtTargetIP" />
            <TextBlock x:Name="TxtFileCount" />
            <TextBlock x:Name="TxtHostname" />
            <TextBlock x:Name="NoPeersHint" />
            <TextBlock x:Name="TxtPeerCount" />
            <TextBlock x:Name="TxtSelectedPeerName" />
            <TextBlock x:Name="TxtSelectedPeerIP" />
            <Border x:Name="PeerCountBadge" />
            <Border x:Name="SelectedPeerCard" />
            <ItemsControl x:Name="PeerItemsControl" />
            <Ellipse x:Name="StatusDot" />
            <Border x:Name="StatusPill" />
            <Border x:Name="DropZone" />
            <ScrollViewer x:Name="LogScroll" />
            <StackPanel x:Name="ManualIPPanel" />
            <StackPanel x:Name="FileListPanel" />
            <ItemsControl x:Name="FileListControl" />
            <Button x:Name="BtnTestConn" />
            <Button x:Name="BtnSend" />
            <RadioButton x:Name="RbSender" />
            <RadioButton x:Name="RbReceiver" />
        </Grid>

        <!-- ═══ 5. PAIRING MODAL ════════════════════════════════════════ -->
        <Grid x:Name="PairingModal" Visibility="Collapsed" Background="#80000000" Grid.RowSpan="2" Grid.ColumnSpan="3">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Width="400" Height="250" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock x:Name="TxtPairingTitle" Text="Bağlantı İsteği" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtPairingMessage" Text="Cihaz sana bağlanmak istiyor." FontSize="14" Foreground="{DynamicResource TextSecBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="16,8">
                            <TextBlock x:Name="TxtPairingPin" Text="123456" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                        </Border>
                    </StackPanel>

                    <!-- Buttons for Receive Mode -->
                    <Grid x:Name="PairingReceiveButtons" Grid.Row="2" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnPairingReject" Grid.Column="0" Content="Reddet" Style="{StaticResource DangerButton}" Height="40" Click="BtnPairingReject_Click"/>
                        <Button x:Name="BtnPairingAccept" Grid.Column="2" Content="Onayla" Style="{StaticResource SuccessButton}" Height="40" Click="BtnPairingAccept_Click"/>
                    </Grid>

                    <!-- Buttons for Send Mode -->
                    <Grid x:Name="PairingSendButtons" Grid.Row="2" Visibility="Collapsed">
                        <Button x:Name="BtnPairingCancel" Content="İptal Et" Style="{StaticResource SecondaryButton}" Height="40" Width="120" HorizontalAlignment="Center" Click="BtnPairingCancel_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
    </Grid>
    </Border>
</Window>
