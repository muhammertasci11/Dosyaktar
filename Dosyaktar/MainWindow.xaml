<Window x:Class="Dosyaktar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:Dosyaktar.Views"
        xmlns:controls="clr-namespace:Dosyaktar.Controls"
        xmlns:fx="clr-namespace:Dosyaktar.Fx"
        xmlns:loc="clr-namespace:Dosyaktar.Localization"
        Title="Dosyaktar"
        Width="1320" Height="860"
        MinWidth="1020" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource AtmosphereBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>

        <!-- ══════════════ ambient drift (started in code, reduced-motion aware) -->
        <Storyboard x:Key="AmbientDrift">
            <DoubleAnimation Storyboard.TargetName="BlobAOffset" Storyboard.TargetProperty="X"
                             From="0" To="64" Duration="0:0:24" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobAOffset" Storyboard.TargetProperty="Y"
                             From="0" To="46" Duration="0:0:29" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobBOffset" Storyboard.TargetProperty="X"
                             From="0" To="-58" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobBOffset" Storyboard.TargetProperty="Y"
                             From="0" To="38" Duration="0:0:26" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobCOffset" Storyboard.TargetProperty="X"
                             From="0" To="52" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobCOffset" Storyboard.TargetProperty="Y"
                             From="0" To="-44" Duration="0:0:33" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- ── peer card ─────────────────────────────────────────────── -->
        <DataTemplate x:Key="PeerCardTemplate">
            <Border Style="{StaticResource GlassCard}"
                    Width="286" Margin="0,0,14,14" Padding="16"
                    Cursor="Hand"
                    fx:Tilt.IsEnabled="True" fx:Tilt.Strength="6"
                    ToolTip="{loc:T 'Cihaza bağlanmak için tıklayın'}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="46" Height="46" CornerRadius="14"
                                Background="{DynamicResource PrimaryGradientBrush}">
                            <TextBlock Text="{Binding ConnectionIcon}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="20" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontSize="14" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding IP}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,13"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="PeerDot" Width="6" Height="6" VerticalAlignment="Center"
                                         Margin="0,0,6,0"
                                         Fill="{DynamicResource TextMutedBrush}"/>
                                <TextBlock x:Name="PeerStatus" Text="{Binding StatusText}"
                                           FontSize="11.5"
                                           Foreground="{DynamicResource TextSecBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Version, StringFormat=v{0}}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="{loc:T 'Gönder'}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,7"
                                FontSize="12"
                                Tag="{Binding}"
                                Click="BtnSendToPeer_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsReceiving}" Value="True">
                    <Setter TargetName="PeerDot" Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                    <Setter TargetName="PeerStatus" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── queue item ───────────────────────────────────────────── -->
        <DataTemplate x:Key="QueueItemTemplate">
            <Border CornerRadius="12" Padding="10,9" Margin="0,0,0,7"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE7C3;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            Tag="{Binding}" Click="BtnRemoveQueued_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── log item ─────────────────────────────────────────────── -->
        <DataTemplate x:Key="LogItemTemplate">
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" FontSize="10"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="0,1,8,0"/>
                <TextBlock x:Name="LogText" Grid.Column="1" Text="{Binding Text}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecBrush}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="ok">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="warn">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="err">
                    <Setter TargetName="LogText" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── history item ─────────────────────────────────────────── -->
        <DataTemplate x:Key="HistoryItemTemplate">
            <Border x:Name="HistoryRow" CornerRadius="14" Padding="14,12" Margin="0,0,0,9"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    Focusable="True" Cursor="Hand"
                    ToolTip="{loc:T 'Dosya konumunu açar (çift tık veya Enter)'}"
                    MouseLeftButtonDown="HistoryRow_MouseLeftButtonDown"
                    KeyDown="HistoryRow_KeyDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="12"
                            Background="{DynamicResource Surface2Brush}">
                        <TextBlock x:Name="HIcon" Text="{Binding Icon}"
                                   FontFamily="{StaticResource IconFont}" FontSize="15"
                                   Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding WhenText}"
                               FontSize="10.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="Received">
                    <Setter TargetName="HIcon" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Success}" Value="False">
                    <Setter TargetName="HIcon" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </DataTrigger>
                <Trigger SourceName="HistoryRow" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="HistoryRow" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── mobile session ───────────────────────────────────────── -->
        <DataTemplate x:Key="MobileSessionTemplate">
            <Border CornerRadius="14" Padding="14,12" Margin="0,0,0,9"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38" Height="38" CornerRadius="12"
                            Background="{DynamicResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Foreground="{DynamicResource SuccessInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SinceText}" FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource GhostButton}"
                            Content="{loc:T 'Kes'}" FontSize="11" Padding="10,6"
                            Tag="{Binding}" Click="BtnDisconnectMobile_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── shared file ──────────────────────────────────────────── -->
        <DataTemplate x:Key="SharedFileTemplate">
            <Border CornerRadius="12" Padding="11,9" Margin="0,0,0,7"
                    Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="30" Height="30" CornerRadius="9"
                            Background="{DynamicResource Accent2GlowBrush}">
                        <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}"
                                   FontSize="13" Foreground="{DynamicResource AccentInkBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SizeText}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}"
                            Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            Tag="{Binding}" Click="BtnRemoveShared_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── setting row ──────────────────────────────────────────── -->
        <Style x:Key="SettingCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
            <Setter Property="Padding" Value="22"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource SectionText}">
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <!-- ── profil: alt köşedeki avatar düğmesi ─────────────────── -->
        <Style x:Key="AvatarTileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Width="38" Height="38" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="focus" CornerRadius="14" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AccentInkBrush}"
                                    Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border x:Name="hint" Width="15" Height="15" CornerRadius="7.5"
                                    Background="{DynamicResource AccentFillBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-3,-3" Opacity="0">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}"
                                           FontSize="7.5" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hint" Property="Opacity" Value="1"/>
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="focus" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── profil: kategori filtresi ───────────────────────────── -->
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ring" CornerRadius="16" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AccentInkBrush}"
                                    Margin="-2.5" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="face" CornerRadius="14"
                                    Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1" Padding="13,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource AccentGhostBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── profil: avatar seçim kutusu ─────────────────────────── -->
        <Style x:Key="AvatarPickTile" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="78">
                            <Border x:Name="ring" CornerRadius="24" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AccentInkBrush}"
                                    Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="face" CornerRadius="21"
                                    Background="{DynamicResource CardFaceBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1" Padding="5,5,5,6"
                                    RenderTransformOrigin="0.5,0.42">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <StackPanel>
                                    <ContentPresenter HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="tName" Text="{TemplateBinding Tag}"
                                               FontSize="10" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="check" Width="16" Height="16" CornerRadius="8"
                                    Background="{DynamicResource AccentFillBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="2,2,2,0" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                           FontSize="8" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                <Setter TargetName="face" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
                                <Setter TargetName="face" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="tName" Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- ══════════════ ambient light field ══════════════ -->
        <Grid x:Name="AmbientField" IsHitTestVisible="False" ClipToBounds="True">
            <!-- hairline mesh, faded towards the edges -->
            <Rectangle Fill="{DynamicResource MeshBrush}" Opacity="0.9">
                <Rectangle.OpacityMask>
                    <RadialGradientBrush GradientOrigin="0.5,0.16" Center="0.5,0.16"
                                         RadiusX="0.92" RadiusY="0.78">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#B8FFFFFF" Offset="0.45"/>
                        <GradientStop Color="#00FFFFFF" Offset="0.86"/>
                    </RadialGradientBrush>
                </Rectangle.OpacityMask>
            </Rectangle>

            <!-- slow-drifting colour blobs -->
            <Ellipse Width="980" Height="980" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-380,-440,0,0" Fill="{DynamicResource AccentGlowBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobAOffset"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,-320,-240,0" Fill="{DynamicResource Accent2GlowBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobBOffset"/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                     Margin="0,0,0,-430" Fill="{DynamicResource Accent2GlowBrush}" Opacity="0.8">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="BlobCOffset"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- ══════════════ pointer light ══════════════ -->
        <Canvas x:Name="CursorGlowLayer" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="CursorGlow" Width="620" Height="620" Opacity="0"
                     Fill="{DynamicResource CursorGlowBrush}">
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="CursorGlowOffset"/>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════ TITLE BAR ══════════════════════ -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="{DynamicResource ChromeBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                        Background="{DynamicResource DividerBrush}" Opacity="0.7"
                        IsHitTestVisible="False"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <!-- gerçek uygulama logosu -->
                    <Image Source="/Assets/icon.png" Width="30" Height="30"
                           Margin="0,0,10,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           ToolTip="{loc:T 'Dosyaktar'}">
                        <Image.Clip>
                            <RectangleGeometry Rect="0,0,30,30" RadiusX="9" RadiusY="9"/>
                        </Image.Clip>
                    </Image>

                    <TextBlock Text="{loc:T 'Dosyaktar'}" FontFamily="{StaticResource DisplayFont}"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                    <Border Style="{StaticResource ChipBadge}" Margin="9,0,0,0" Padding="7,2">
                        <TextBlock x:Name="TxtTitleVersion" Text="v2.1"
                                   FontSize="9.5" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentInkBrush}"/>
                    </Border>

                    <Border Width="1" Height="16" Background="{DynamicResource DividerBrush}" Margin="14,0"/>

                    <TextBlock x:Name="TxtPageTitle" Text="{loc:T 'Keşif'}"
                               FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource ChipBadge}" Margin="0,0,10,0"
                            Padding="10,5" Background="{DynamicResource SuccessSoftBrush}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtTitleNet" Text="{loc:T 'LAN'}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessInkBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource IconButton}" Content="&#xE921;"
                            Click="BtnMinimize_Click" ToolTip="{loc:T 'Küçült'}"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE922;"
                            Click="BtnMaximize_Click" ToolTip="{loc:T 'Büyüt'}" Margin="2,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                            Click="BtnCloseWindow_Click" Foreground="{DynamicResource DangerInkBrush}"
                            ToolTip="{loc:T 'Kapat'}"/>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════ BODY ══════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="*" MinWidth="440"/>
                    <ColumnDefinition Width="330"/>
                </Grid.ColumnDefinitions>

                <!-- ════ PAGE: OYUNLAR (tam genişlik: sağ panel gizlenir) ════ -->
                <Grid x:Name="PageGames"
                      Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="14,0,10,10"
                      Visibility="Collapsed">
                    <views:GameLibraryView x:Name="GamesView"/>
                </Grid>

                <!-- ════ PAGE: PROFİL / KİŞİSELLEŞTİRME ════ -->
                <Grid x:Name="PageProfile"
                      Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="14,0,10,10"
                      Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <StackPanel Margin="6,6,6,10">

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:T 'KİŞİSELLEŞTİRME'}" Style="{StaticResource EyebrowText}"
                                               Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                    <TextBlock Text="{loc:T 'Profil ve avatarlar'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                    <TextBlock Text="{loc:T 'Adını yaz, animasyonlu avatarını seç. Ağda bu kimlikle görünürsün.'}"
                                               Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        VerticalAlignment="Bottom" Click="BtnProfileBack_Click"
                                        ToolTip="{loc:T 'Önceki sayfaya dön (Esc)'}"
                                        AutomationProperties.Name="Geri dön">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{loc:T 'Geri'}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="306"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- canlı önizleme -->
                                <Border Style="{StaticResource GlassCard}" VerticalAlignment="Top" Padding="22">
                                    <StackPanel>
                                        <Grid Height="204">
                                            <Ellipse Width="182" Height="182"
                                                     Fill="{DynamicResource AccentGlowBrush}"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Ellipse Width="150" Height="150" Stroke="{DynamicResource AccentBorderBrush}"
                                                     StrokeThickness="1" StrokeDashArray="2 4" Opacity="0.45"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <controls:AnimatedAvatar x:Name="ProfilePreview"
                                                                     Width="158" Height="158"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock x:Name="TxtProfilePreviewName" Text="{loc:T 'Dosyaktar'}"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="21" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtProfileAvatarName" Text="{loc:T 'Kedi'}"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,18,0,16"/>

                                        <TextBlock Text="{loc:T 'GÖRÜNEN AD'}" Style="{StaticResource EyebrowText}" Margin="0,0,0,7"/>
                                        <TextBox x:Name="TxtProfileName" Style="{StaticResource ModernTextBox}"
                                                 MaxLength="32" Tag="Cihaz adın"
                                                 TextChanged="TxtProfileName_TextChanged"
                                                 LostFocus="TxtProfileName_LostFocus"
                                                 KeyDown="TxtProfileName_KeyDown"
                                                 AutomationProperties.Name="Görünen ad"/>
                                        <TextBlock Text="{loc:T 'Aynı ağdaki cihazlar ve mobil köprü bu adı görür.'}"
                                                   Style="{StaticResource MutedText}" Margin="0,7,0,0"
                                                   TextWrapping="Wrap"/>

                                        <Border Style="{StaticResource ChipBadge}" HorizontalAlignment="Left"
                                                Margin="0,14,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="9" Foreground="{DynamicResource AccentInkBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <TextBlock Text="{loc:T 'Canlı önizleme'}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- avatar galerisi -->
                                <Border Grid.Column="1" Style="{StaticResource GlassCard}"
                                        Margin="18,0,0,0" Padding="22" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{loc:T 'Avatar galerisi'}" Style="{StaticResource SectionText}" FontSize="16"/>
                                                <TextBlock Text="{loc:T '32 avatar · her biri kendi ritminde hareket eder'}"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Style="{StaticResource ChipBadge}" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAvatarCount" Text="32"
                                                           FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}"
                                                           MinWidth="14" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>

                                        <WrapPanel x:Name="AvatarCategoryBar" Margin="0,10,0,2">
                                            <RadioButton Content="{loc:T 'Tümü'}" Tag="Tümü" GroupName="avatarFilter"
                                                         Style="{StaticResource FilterChip}" IsChecked="True"
                                                         Checked="AvatarFilter_Checked"/>
                                            <RadioButton Content="{loc:T 'Hayvanlar'}" Tag="Hayvanlar" GroupName="avatarFilter"
                                                         Style="{StaticResource FilterChip}"
                                                         Checked="AvatarFilter_Checked"/>
                                            <RadioButton Content="{loc:T 'Uzay'}" Tag="Uzay" GroupName="avatarFilter"
                                                         Style="{StaticResource FilterChip}"
                                                         Checked="AvatarFilter_Checked"/>
                                            <RadioButton Content="{loc:T 'Doğa'}" Tag="Doğa" GroupName="avatarFilter"
                                                         Style="{StaticResource FilterChip}"
                                                         Checked="AvatarFilter_Checked"/>
                                            <RadioButton Content="{loc:T 'Karakterler'}" Tag="Karakterler" GroupName="avatarFilter"
                                                         Style="{StaticResource FilterChip}"
                                                         Checked="AvatarFilter_Checked"/>
                                        </WrapPanel>

                                        <WrapPanel x:Name="AvatarGallery" Margin="0,10,0,0"/>

                                        <TextBlock x:Name="EmptyAvatarFilter" Text="{loc:T 'Bu kategoride avatar yok.'}"
                                                   Style="{StaticResource MutedText}" Visibility="Collapsed"/>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,8,0,12"/>
                                        <TextBlock Text="{loc:T 'Bir avatara tıkla — seçim anında kaydedilir. Hareket azaltma açıksa avatarlar sabit görünür.'}"
                                                   Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ─────────── icon rail ─────────── -->
                <Border Grid.Column="0" Margin="10,0,0,10"
                        Background="{DynamicResource CardFaceBrush}"
                        BorderBrush="{DynamicResource GlassBorderBrush}"
                        BorderThickness="1" CornerRadius="24"
                        Effect="{DynamicResource CardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,16,0,10" HorizontalAlignment="Center">
                            <Border Width="38" Height="3" CornerRadius="2"
                                    Background="{DynamicResource PrimaryGradientBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="9,4" VerticalAlignment="Top">
                            <controls:NavTabButton x:Name="RbSend" GroupName="nav" IsChecked="True"
                                         Content="{loc:T 'Keşif'}" IconData="{StaticResource IconCompass}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <controls:NavTabButton x:Name="RbSession" GroupName="nav"
                                         Content="{loc:T 'Oturum'}" IconData="{StaticResource IconLink}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <controls:NavTabButton x:Name="RbGames" GroupName="nav"
                                         Content="{loc:T 'Oyunlar'}" IconData="{StaticResource IconGamepad}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <controls:NavTabButton x:Name="RbMobile" GroupName="nav"
                                         Content="{loc:T 'Mobil'}" IconData="{StaticResource IconPhone}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <controls:NavTabButton x:Name="RbHistory" GroupName="nav"
                                         Content="{loc:T 'Geçmiş'}" IconData="{StaticResource IconHistory}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                            <controls:NavTabButton x:Name="RbSettings" GroupName="nav"
                                         Content="{loc:T 'Ayarlar'}" IconData="{StaticResource IconTune}"
                                         Style="{StaticResource SidebarTabButton}"
                                         Checked="Nav_Checked"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="9,0,9,12">
                            <Button Style="{StaticResource IconButton}" Content="&#xE790;"
                                    Width="Auto" Height="34" FontSize="16"
                                    Click="BtnThemeCycle_Click" ToolTip="{loc:T 'Temayı değiştir'}"/>
                            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="8,8"/>
                            <Button x:Name="AvatarTile" Style="{StaticResource AvatarTileButton}"
                                    HorizontalAlignment="Center"
                                    Click="AvatarTile_Click"
                                    ToolTip="{loc:T 'Profil ve avatarlar'}"
                                    AutomationProperties.Name="Profil ve avatarlar">
                                <controls:AnimatedAvatar x:Name="AvatarSmall" Width="30" Height="30"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ─────────── main content ─────────── -->
                <Grid Grid.Column="1" Margin="14,0,0,10">

                    <!-- ════ PAGE: KEŞİF ════ -->
                    <Grid x:Name="PageSend">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="6,6,6,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:T 'AKTARIM'}" Style="{StaticResource EyebrowText}"
                                           Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                <TextBlock Text="{loc:T 'Yakındaki cihazlar'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                <TextBlock x:Name="TxtPeerSubtitle" Text="{loc:T 'Aynı ağdaki cihazlar aranıyor…'}"
                                           Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T 'Oyunlar'}"
                                        Padding="14,9" Margin="0,0,8,0" Click="BtnGameTransfer_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                                        Width="38" Height="38" Click="BtnRefresh_Click" ToolTip="{loc:T 'Yenile'}"/>
                            </StackPanel>
                        </Grid>

                        <!-- peer strip -->
                        <Border Grid.Row="1" Margin="0,0,0,14">
                            <Grid>
                                <ScrollViewer x:Name="PeerScroll" VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Auto" Padding="0,0,0,4">
                                    <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerCardTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Border x:Name="EmptyPeers" CornerRadius="20" Padding="26"
                                        Background="{DynamicResource CardFaceBrush}"
                                        BorderBrush="{DynamicResource GlassBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Grid Width="48" Height="48" Margin="0,0,16,0">
                                            <!-- Sabit dış çerçeve -->
                                            <Ellipse x:Name="ScanRing" Width="44" Height="44"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4"
                                                     Opacity="0.30"/>

                                            <!-- Sürekli genişleyen sonar halkaları -->
                                            <Ellipse x:Name="ScanPingA" Width="44" Height="44"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.3"
                                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="ScanPingAScale" ScaleX="0.32" ScaleY="0.32"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <Ellipse x:Name="ScanPingB" Width="44" Height="44"
                                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.1"
                                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="ScanPingBScale" ScaleX="0.32" ScaleY="0.32"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>

                                            <!-- Dönen tarama yayı -->
                                            <Path x:Name="ScanSweep"
                                                  Data="M 24,4 A 20,20 0 0 1 41.3,14"
                                                  Width="48" Height="48" Stretch="None"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Opacity="0.75">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ScanSweepRotate"
                                                                     CenterX="24" CenterY="24" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>

                                            <!-- Yumuşak çekirdek ve nabız atan merkez -->
                                            <Ellipse Width="26" Height="26"
                                                     Fill="{DynamicResource AccentSoftBrush}"/>
                                            <Ellipse x:Name="ScanDot" Width="8" Height="8"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="ScanDotScale" ScaleX="1" ScaleY="1"/>
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:T 'Cihaz aranıyor'}" Style="{StaticResource SectionText}"/>
                                            <TextBlock Text="{loc:T 'Karşı tarafta Dosyaktar açık olmalı ve iki cihaz aynı ağda olmalı.'}"
                                                       Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- drop zone -->
                        <Border Grid.Row="2" x:Name="DropZone" CornerRadius="24" Margin="0,0,0,2"
                                AllowDrop="True"
                                Background="{DynamicResource CardFaceBrush}"
                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                BorderThickness="1" Padding="0"
                                Effect="{DynamicResource CardShadow}"
                                DragEnter="DropZone_DragEnter"
                                DragLeave="DropZone_DragLeave"
                                Drop="DropZone_Drop"
                                MouseDown="DropZone_MouseDown"
                                MouseMove="DropZone_MouseMove"
                                MouseLeave="DropZone_MouseLeave"
                                Cursor="Hand">
                            <Grid>
                                <Border CornerRadius="24" Background="{DynamicResource HeroBandBrush}"
                                        Opacity="0.55" IsHitTestVisible="False"/>
                                <!-- pointer glare, moved in code behind -->
                                <Border x:Name="DropSheen" CornerRadius="24" IsHitTestVisible="False"
                                        Opacity="0" Margin="1">
                                    <Border.Background>
                                        <RadialGradientBrush x:Name="DropSheenBrush"
                                                             GradientOrigin="0.5,0.45"
                                                             Center="0.5,0.45"
                                                             RadiusX="0.42" RadiusY="0.42">
                                            <GradientStop Color="#6EFFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Margin="30">
                                    <Border Width="66" Height="66" CornerRadius="20"
                                            Background="{DynamicResource PrimaryGradientBrush}"
                                            HorizontalAlignment="Center"
                                            Effect="{DynamicResource AccentShadow}">
                                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}"
                                                   FontSize="26" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <TextBlock Text="{loc:T 'Dosyaları buraya bırak'}" FontFamily="{StaticResource DisplayFont}"
                                               FontSize="19" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,18,0,4"/>
                                    <TextBlock x:Name="TxtDropHint"
                                               Text="{loc:T &quot;Klasör, oyun veya 50 GB'lık tek dosya — hepsi olur.&quot;}"
                                               Style="{StaticResource MutedText}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" MaxWidth="440"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button Content="{loc:T 'Dosya seç'}" Style="{StaticResource PrimaryButton}"
                                                Padding="20,11" Click="BtnPickFiles_Click"/>
                                        <Button Content="{loc:T 'Klasör seç'}" Style="{StaticResource SecondaryButton}"
                                                Padding="18,11" Margin="9,0,0,0" Click="BtnPickFolder_Click"/>
                                    </StackPanel>

                                    <Border x:Name="SelectedTargetBar" Visibility="Collapsed"
                                            CornerRadius="12" Padding="12,8" Margin="0,18,0,0"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE727;" FontFamily="{StaticResource IconFont}"
                                                       FontSize="12" Foreground="{DynamicResource AccentInkBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{loc:T 'Hedef:'}" FontSize="11.5"
                                                       Foreground="{DynamicResource TextSecBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTargetName" FontSize="11.5" FontWeight="SemiBold"
                                                       Margin="5,0,0,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtTargetIp" FontSize="11.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;"
                                                    Width="22" Height="22" FontSize="9" Margin="8,0,0,0"
                                                    Click="BtnClearTarget_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ════ PAGE: OTURUM ════ -->
                    <Grid x:Name="PageSession" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,6,6,0">
                                <TextBlock Text="{loc:T 'OTURUM'}" Style="{StaticResource EyebrowText}"
                                           Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                <TextBlock Text="{loc:T 'Aktif oturum'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                <TextBlock Text="{loc:T 'Eşleşen cihazla canlı bağlantı.'}"
                                           Style="{StaticResource MutedText}" Margin="0,3,0,20"/>

                                <!-- connected card -->
                                <Border x:Name="SessionActive" Style="{StaticResource GlassCard}" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="54" Height="54" CornerRadius="16"
                                                    Background="{DynamicResource PrimaryGradientBrush}">
                                                <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="22" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSessName" Text="{loc:T 'Cihaz'}"
                                                           FontFamily="{StaticResource DisplayFont}"
                                                           FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="TxtSessIp" Text="—" Style="{StaticResource MutedText}"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ChipBadge}"
                                                        Background="{DynamicResource SuccessSoftBrush}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{loc:T 'Bağlı'}" FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessInkBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{loc:T 'OTURUM'}" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessSince" Text="—" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:T 'PORT'}" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessPort" Text="5001" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{loc:T 'MOD'}" Style="{StaticResource EyebrowText}"/>
                                                <TextBlock x:Name="TxtSessMode" Text="{loc:T 'Standart'}" FontSize="12.5" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}"/>

                                        <TextBlock x:Name="TxtSessionPercent" Text="{loc:T 'Hazır'}"
                                                   Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
                                        <ProgressBar x:Name="PbSession" Style="{StaticResource ModernProgress}" Value="0"/>
                                        <Grid Margin="0,8,0,0">
                                            <TextBlock x:Name="TxtSessionSpeed" Text="—" Style="{StaticResource MutedText}"/>
                                            <TextBlock x:Name="TxtSessionEta" Text="" Style="{StaticResource MutedText}"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                            <Button Content="{loc:T 'Dosya gönder'}" Style="{StaticResource PrimaryButton}"
                                                    Click="BtnSessionSendFiles_Click"/>
                                            <Button Content="{loc:T 'Klasör gönder'}" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnSessionSendFolder_Click"/>
                                            <Button x:Name="BtnReceiveToggle" Content="{loc:T 'Almayı durdur'}"
                                                    Style="{StaticResource GhostButton}"
                                                    Margin="9,0,0,0" Click="BtnReceiveToggle_Click"/>
                                            <Button Content="{loc:T 'Bağlantıyı kes'}" Style="{StaticResource GhostButton}"
                                                    Margin="16,0,0,0"
                                                    Click="BtnDisconnect_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- not connected -->
                                <Border x:Name="SessionEmpty" Style="{StaticResource GlassCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Henüz bir cihaza bağlı değilsin'}"
                                                   Style="{StaticResource SectionText}" FontSize="16"/>
                                        <TextBlock Text="{loc:T &quot;Keşif sekmesinden bir cihaz seç ya da karşı ekranda beliren PIN'i buraya gir.&quot;}"
                                                   Style="{StaticResource MutedText}" Margin="0,4,0,18"/>

                                        <TextBlock Text="{loc:T 'PIN ile eşleş'}" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="TxtPairPin" Style="{StaticResource ModernTextBox}"
                                                     Width="170" MaxLength="6" FontSize="20"
                                                     FontFamily="{StaticResource MonoFont}"
                                                     Tag="000000" VerticalContentAlignment="Center"/>
                                            <Button Content="{loc:T 'Eşleş'}" Style="{StaticResource PrimaryButton}"
                                                    Margin="9,0,0,0" Click="BtnPairWithPin_Click"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,20"/>

                                        <TextBlock Text="{loc:T 'IP ile doğrudan bağlan'}" Style="{StaticResource EyebrowText}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="TxtManualIp" Style="{StaticResource ModernTextBox}"
                                                     Width="200" Tag="192.168.1.24"/>
                                            <Button Content="{loc:T 'Bağlan'}" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnManualConnect_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: MOBİL ════ -->
                    <Grid x:Name="PageMobile" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="6,6,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'TELEFON KÖPRÜSÜ'}" Style="{StaticResource EyebrowText}"
                                                   Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                        <TextBlock Text="{loc:T 'Mobil köprü'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                        <TextBlock Text="{loc:T 'Telefonun tarayıcısından gönder ve al — uygulama kurmadan.'}"
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button x:Name="BtnToggleBridge" Content="{loc:T 'Köprüyü kapat'}"
                                                Style="{StaticResource SecondaryButton}" Click="BtnToggleBridge_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- QR -->
                                    <Border Style="{StaticResource GlassCard}" Width="266">
                                        <StackPanel>
                                            <Border CornerRadius="16" Padding="12"
                                                    Background="White" HorizontalAlignment="Center">
                                                <Image x:Name="ImgQr" Width="196" Height="196"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                            </Border>

                                            <TextBlock Text="{loc:T 'Telefonla tara'}" Style="{StaticResource SectionText}"
                                                       HorizontalAlignment="Center" Margin="0,14,0,2"/>
                                            <TextBlock x:Name="TxtMobileUrl" Text="{loc:T 'http://—'}"
                                                       Style="{StaticResource MonoText}"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       TextWrapping="Wrap"/>
                                            <Button Content="{loc:T 'Adresi kopyala'}" Style="{StaticResource GhostButton}"
                                                    Margin="0,6,0,0" Click="BtnCopyUrl_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- PIN + sessions -->
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="{loc:T 'Bağlantı kodu'}" Style="{StaticResource EyebrowText}"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Ellipse Width="7" Height="7" x:Name="BridgeDot"
                                                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                                                 Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TxtBridgeState" Text="{loc:T 'Yayında'}"
                                                                   FontSize="10.5" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessInkBrush}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock x:Name="TxtMobilePin" Text="000 000"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontSize="38" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,6,0,0"/>

                                                <TextBlock x:Name="TxtMobileIp" Text="—"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>

                                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                    <Button Content="{loc:T 'Yeni kod'}" Style="{StaticResource SecondaryButton}"
                                                            Padding="14,9" Click="BtnNewPin_Click"/>
                                                    <Button Content="{loc:T &quot;IP'yi kopyala&quot;}" Style="{StaticResource GhostButton}"
                                                            Padding="12,9" Margin="6,0,0,0" Click="BtnCopyIp_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource GlassCard}">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock Text="{loc:T 'Bağlı telefonlar'}" Style="{StaticResource SectionText}"/>
                                                    <TextBlock x:Name="TxtMobileCount" Text="0"
                                                               FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentInkBrush}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <ItemsControl x:Name="MobileSessionsList"
                                                              ItemTemplate="{StaticResource MobileSessionTemplate}"/>

                                                <TextBlock x:Name="EmptyMobileSessions"
                                                           Text="{loc:T &quot;Henüz telefon bağlanmadı. QR'ı okutman yeterli.&quot;}"
                                                           Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- shared files -->
                                <Border Style="{StaticResource GlassCard}" Margin="0,16,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="{loc:T 'Telefona açılan dosyalar'}" Style="{StaticResource SectionText}"/>
                                                <TextBlock Text="{loc:T &quot;Buraya eklediğin dosyalar telefonun 'Al' sekmesinde görünür.&quot;}"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtSharedCount" Text="{loc:T '0 dosya'}"
                                                           Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="{loc:T 'Dosya ekle'}" Style="{StaticResource PrimaryButton}"
                                                        Padding="16,9" Click="BtnAddShared_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl x:Name="SharedFilesList"
                                                      ItemTemplate="{StaticResource SharedFileTemplate}"/>
                                        <TextBlock x:Name="EmptyShared"
                                                   Text="{loc:T 'Henüz dosya paylaşmadın.'}"
                                                   Style="{StaticResource MutedText}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: GEÇMİŞ ════ -->
                    <Grid x:Name="PageHistory" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel Margin="6,6,6,0">
                                <Grid Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'KAYITLAR'}" Style="{StaticResource EyebrowText}"
                                                   Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                        <TextBlock Text="{loc:T 'Transfer geçmişi'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                        <TextBlock Text="{loc:T 'Son 250 aktarım, cihazında saklanır.'}"
                                                   Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="BtnClearHistory" Style="{StaticResource SecondaryButton}"
                                            Content="{loc:T 'Geçmişi temizle'}"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Click="BtnClearHistory_Click"/>
                                </Grid>

                                <Grid>
                                    <ItemsControl x:Name="HistoryList" ItemTemplate="{StaticResource HistoryItemTemplate}"/>

                                    <Border x:Name="EmptyHistory" Style="{StaticResource GlassCard}" MinHeight="380">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20">
                                            <Border Width="62" Height="62" CornerRadius="20"
                                                    HorizontalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftBrush}">
                                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="26" Foreground="{DynamicResource AccentInkBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{loc:T 'Henüz aktarım yok'}" Style="{StaticResource SectionText}"
                                                       HorizontalAlignment="Center" Margin="0,16,0,3"/>
                                            <TextBlock Text="{loc:T 'İlk dosyanı gönderdiğinde burada görünecek.'}"
                                                       Style="{StaticResource MutedText}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ════ PAGE: AYARLAR ════ -->
                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                            <StackPanel Margin="6,6,6,0">
                                <TextBlock Text="{loc:T 'TERCİHLER'}" Style="{StaticResource EyebrowText}"
                                           Foreground="{DynamicResource AccentInkBrush}" Margin="0,0,0,7"/>
                                <TextBlock Text="{loc:T 'Ayarlar'}" Style="{StaticResource DisplayText}" FontSize="26"/>
                                <TextBlock Text="{loc:T 'Görünüm, ağ ve aktarım davranışı.'}"
                                           Style="{StaticResource MutedText}" Margin="0,3,0,16"/>

                                <!-- themes -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="{loc:T 'Tema'}" Style="{StaticResource SettingLabel}"/>
                                                <TextBlock Text="{loc:T 'Seçim anında uygulanır ve hatırlanır.'}"
                                                           Style="{StaticResource MutedText}"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtActiveTheme" Text="{loc:T 'Prism'}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentInkBrush}"/>
                                        </Grid>

                                        <WrapPanel x:Name="ThemeGallery"/>
                                    </StackPanel>
                                </Border>

                                <!-- language -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Dil'}" Style="{StaticResource SettingLabel}"/>
                                        <TextBlock Text="{loc:T 'Arayüz dili anında değişir.'}"
                                                   Style="{StaticResource MutedText}" Margin="0,2,0,12"/>
                                        <WrapPanel x:Name="LangPanel">
                                            <RadioButton x:Name="LangTr" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="Türkçe" Tag="tr" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangEn" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="English" Tag="en" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangDe" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="Deutsch" Tag="de" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangFr" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="Français" Tag="fr" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangEs" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="Español" Tag="es" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                            <RadioButton x:Name="LangJa" Style="{StaticResource TabRadioButton}" GroupName="lang"
                                                         Content="日本語" Tag="ja" Margin="0,0,8,8" Checked="Lang_Checked"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- network -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Ağ'}" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{loc:T 'Cihaz adı'}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtHostname" Style="{StaticResource ModernTextBox}"
                                                         LostFocus="Setting_Changed"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{loc:T 'Aktarım portu'}" Style="{StaticResource MutedText}" Margin="0,0,0,6"/>
                                                <TextBox x:Name="TxtPort" Style="{StaticResource ModernTextBox}"
                                                         LostFocus="Setting_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,18,0,14"/>

                                        <CheckBox x:Name="ChkAutoReceive" Style="{StaticResource ToggleSwitch}"
                                                  Content="{loc:T 'Otomatik alma modu — gelen aktarımları sormadan kabul et'}"
                                                  Click="Setting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- storage -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Kayıt yeri'}" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TxtDownloadFolder" Style="{StaticResource ModernTextBox}"
                                                     LostFocus="Setting_Changed"/>
                                            <Button Grid.Column="1" Content="{loc:T 'Gözat'}" Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0" Click="BtnBrowseFolder_Click"/>
                                        </Grid>

                                        <Button Content="{loc:T 'Klasörü aç'}" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Click="BtnOpenDownloadFolder_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- transfer -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Aktarım'}" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <CheckBox x:Name="ChkFlashMode" Style="{StaticResource ToggleSwitch}"
                                                  Content="{loc:T 'Flash modu — dosyayı paralel kanallara böl'}"
                                                  Click="Setting_Changed"/>

                                        <StackPanel Margin="0,18,0,0">
                                            <Grid>
                                                <TextBlock Text="{loc:T 'Paralel kanal sayısı'}" Style="{StaticResource MutedText}"/>
                                                <TextBlock x:Name="TxtFlashConns" Text="8"
                                                           HorizontalAlignment="Right"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentInkBrush}"/>
                                            </Grid>
                                            <Slider x:Name="SliFlashConns" Style="{StaticResource ModernSlider}"
                                                    Minimum="2" Maximum="32" TickFrequency="1"
                                                    IsSnapToTickEnabled="True" Value="8"
                                                    Margin="0,6,0,0"
                                                    ValueChanged="SliFlashConns_ValueChanged"/>
                                        </StackPanel>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,14,0,14"/>

                                        <CheckBox x:Name="ChkCheckUpdates" Style="{StaticResource ToggleSwitch}"
                                                  Content="{loc:T 'Açılışta güncellemeleri kontrol et'}"
                                                  Click="Setting_Changed"/>
                                        <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitch}"
                                                  Content="{loc:T 'Yeni sürümü arka planda indir'}"
                                                  Margin="0,14,0,0" Click="Setting_Changed"/>
                                    </StackPanel>
                                </Border>

                                <!-- about -->
                                <Border Style="{StaticResource SettingCard}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:T 'Uygulama'}" Style="{StaticResource SettingLabel}" Margin="0,0,0,14"/>

                                        <Grid>
                                            <StackPanel>
                                                <TextBlock x:Name="TxtAppVersion" Text="Dosyaktar v2.1.0"
                                                           FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{loc:T '.NET 8 · WPF · tek dosya'}"
                                                           Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Content="{loc:T 'Güncellemeleri kontrol et'}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Click="BtnCheckUpdates_Click"/>
                                        </Grid>

                                        <Border Style="{StaticResource DividerLine}" Margin="0,16,0,14"/>

                                        <Button Content="{loc:T 'Uygulama verilerini sıfırla'}"
                                                Style="{StaticResource DangerButton}"
                                                HorizontalAlignment="Left"
                                                Click="BtnResetApp_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- ─────────── right panel ─────────── -->
                <Grid x:Name="RailRight" Grid.Column="2" Margin="0,0,10,10">
                    <Border Background="{DynamicResource CardFaceBrush}"
                            BorderBrush="{DynamicResource GlassBorderBrush}"
                            BorderThickness="1" CornerRadius="24" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- active transfer -->
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{loc:T 'Aktarım'}" Style="{StaticResource SectionText}"/>
                                    <Border Style="{StaticResource ChipBadge}" HorizontalAlignment="Right"
                                            Padding="7,2" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock x:Name="TxtQueueCount" Text="0"
                                                   FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentInkBrush}"/>
                                    </Border>
                                </Grid>

                                <Border x:Name="ActiveTransferCard" Visibility="Collapsed"
                                        CornerRadius="14" Padding="14,12"
                                        Background="{DynamicResource GlassStrongBrush}"
                                        BorderBrush="{DynamicResource AccentBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtActiveName" Text="—"
                                                   FontSize="12.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtActiveDetail" Text=""
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5" Margin="0,2,0,9"
                                                   TextWrapping="Wrap"/>
                                        <ProgressBar x:Name="PbActive" Style="{StaticResource ModernProgress}" Height="8"/>
                                        <Grid Margin="0,7,0,0">
                                            <TextBlock x:Name="TxtActiveSpeed" Text=""
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessInkBrush}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtActivePercent" Text="{loc:T '0%'}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button x:Name="BtnCancelTransfer" Style="{StaticResource IconButton}"
                                                        Content="&#xE711;" Width="22" Height="22" FontSize="9"
                                                        Click="BtnCancelTransfer_Click" ToolTip="{loc:T 'İptal'}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{loc:T 'Kuyruk'}" Style="{StaticResource EyebrowText}" Margin="2,16,0,8"/>
                            </StackPanel>

                            <!-- queue list -->
                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="QueueList" ItemTemplate="{StaticResource QueueItemTemplate}"/>
                                </ScrollViewer>

                                <TextBlock x:Name="EmptyQueue" Text="{loc:T 'Kuyruk boş. Göndermek için dosya ekle.'}"
                                           Style="{StaticResource MutedText}"
                                           TextAlignment="Center" VerticalAlignment="Top"/>
                            </Grid>

                            <!-- activity log -->
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Border Style="{StaticResource DividerLine}" Margin="0,0,0,10"/>
                                <Grid Margin="2,0,0,7">
                                    <TextBlock Text="{loc:T 'Etkinlik'}" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock x:Name="TxtStatusNet" Text="—"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MutedText}" FontSize="10"/>
                                </Grid>
                                <ScrollViewer x:Name="LogScroll" MaxHeight="170"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogItemTemplate}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══════════════════════ STATUS BAR ══════════════════════ -->
            <Border Grid.Row="2" Background="{DynamicResource GlassBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"
                                 Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="{loc:T 'Hazır'}" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStatusMobile" Text="{loc:T 'Mobil köprü: kapalı'}"
                                   FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <Border Width="1" Height="12" Background="{DynamicResource DividerBrush}" Margin="12,0"/>
                        <TextBlock x:Name="TxtStatusVersion" Text="v2.1.0"
                                   FontSize="10.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════════════════ PAIRING OVERLAY ══════════════════════ -->
        <Grid x:Name="PairingOverlay" Visibility="Collapsed"
              Background="{DynamicResource OverlayBrush}">
            <Border Style="{StaticResource GlassCard}" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="30">
                <StackPanel>
                    <Border Width="58" Height="58" CornerRadius="18"
                            Background="{DynamicResource PrimaryGradientBrush}"
                            HorizontalAlignment="Center"
                            Effect="{DynamicResource AccentShadow}">
                        <TextBlock Text="&#xE71B;" FontFamily="{StaticResource IconFont}"
                                   FontSize="24" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{loc:T 'Eşleşme isteği'}" Style="{StaticResource DisplayText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,16,0,4"/>
                    <TextBlock x:Name="TxtPairingHost" Text="{loc:T 'Cihaz'}"
                               Style="{StaticResource SectionText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPairingIp" Text="—"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

                    <Border CornerRadius="14" Padding="16" Margin="0,18,0,0"
                            Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock x:Name="TxtPairingPin" Text="000 000"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="26" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentInkBrush}"/>
                    </Border>

                    <TextBlock x:Name="TxtPairingHint" Text="{loc:T 'Kod iki cihazda da aynıysa kabul edin.'}"
                               Style="{StaticResource MutedText}" HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>

                    <Grid x:Name="PairingActions" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{loc:T 'Reddet'}" Style="{StaticResource DangerButton}"
                                Margin="0,0,5,0" Click="BtnPairingReject_Click"/>
                        <Button Grid.Column="1" Content="{loc:T 'Kabul et'}" Style="{StaticResource PrimaryButton}"
                                Margin="5,0,0,0" Click="BtnPairingAccept_Click"/>
                    </Grid>

                    <Button x:Name="BtnPairingCancel" Content="{loc:T 'İptal'}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Center" Margin="0,8,0,0"
                            Click="BtnPairingCancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════ DROP OVERLAY ══════════════════════ -->
        <Grid x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False"
              Background="{DynamicResource AccentGhostBrush}">
            <Border CornerRadius="26" Margin="90,70" BorderThickness="2"
                    BorderBrush="{DynamicResource AccentBrush}"
                    Background="{DynamicResource GlassStrongBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}"
                               FontSize="42" Foreground="{DynamicResource AccentInkBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T 'Bırak, gerisini biz hallederiz'}"
                               Style="{StaticResource DisplayText}" FontSize="20"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
