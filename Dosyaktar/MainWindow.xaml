<Window x:Class="Dosyaktar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dosyaktar" Height="700" Width="860"
        MinHeight="600" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        Closing="Window_Closing">

    <Grid Margin="32,28,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Başlık -->
            <RowDefinition Height="Auto"/>   <!-- Rol Tab -->
            <RowDefinition Height="Auto"/>   <!-- Bağlantı Paneli -->
            <RowDefinition Height="*"/>      <!-- İçerik -->
            <RowDefinition Height="Auto"/>   <!-- İlerleme -->
            <RowDefinition Height="Auto"/>   <!-- Aksiyon -->
        </Grid.RowDefinitions>

        <!-- ═══ 1. BAŞLIK ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" Background="{DynamicResource AccentBrush}"
                        CornerRadius="10" Margin="0,0,12,0">
                    <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dosyaktar" FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Aynı ağdaki cihazları otomatik bulur"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border x:Name="StatusPill" Background="{DynamicResource Surface2Brush}" CornerRadius="20"
                        Padding="10,5" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                 Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="TxtStatus" Text="Hazır" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Button Content="🎮 Oyun Taşı" Style="{DynamicResource SecondaryButton}"
                        Padding="12,7" FontSize="12" Margin="0,0,8,0"
                        Click="BtnGameTransfer_Click"/>
                <Button x:Name="BtnSettings" Style="{DynamicResource IconButton}"
                        Width="36" Height="36" Click="BtnSettings_Click" ToolTip="Ayarlar">
                    <TextBlock Text="⚙" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ 2. ROL TAB ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource TabBarBrush}" CornerRadius="12"
                Padding="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="RbSender" Grid.Column="0"
                             Content="📤  Dosya Gönder" IsChecked="True"
                             Style="{DynamicResource RoleTabButton}"
                             Checked="Role_Checked"/>
                <RadioButton x:Name="RbReceiver" Grid.Column="1"
                             Content="📥  Dosya Al"
                             Style="{DynamicResource RoleTabButton}"
                             Checked="Role_Checked"/>
            </Grid>
        </Border>

        <!-- ═══ 3. ANA İÇERİK (Cihazlar + Drop Zone yan yana) ══════════════ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>   <!-- Cihaz Listesi -->
                <ColumnDefinition Width="16"/>    <!-- Boşluk -->
                <ColumnDefinition Width="*"/>     <!-- Bağlantı Detayları -->
            </Grid.ColumnDefinitions>

            <!-- ── Cihaz Listesi Paneli ─────────────────────────────────── -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık -->
                    <Border Grid.Row="0" Padding="14,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Yakındaki Cihazlar" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border x:Name="PeerCountBadge" Background="{DynamicResource AccentBrush}"
                                        CornerRadius="10" Padding="6,2" Margin="8,0,0,0"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="TxtPeerCount" Text="0" FontSize="11"
                                               FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <!-- Tarama animasyonu -->
                            <Border x:Name="ScanningIndicator" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtScanning" Text="📡" FontSize="14"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Cihaz Listesi -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PeerListPanel" Margin="8">

                            <!-- Boş durum -->
                            <StackPanel x:Name="NoPeersHint" VerticalAlignment="Center"
                                        HorizontalAlignment="Center" Margin="0,30,0,0">
                                <TextBlock Text="📡" FontSize="32" HorizontalAlignment="Center"
                                           Margin="0,0,0,10"/>
                                <TextBlock Text="Taranıyor..." FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Diğer PC'de de Dosyaktar açık olsun"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="10,6,10,0"/>
                            </StackPanel>

                            <!-- Cihaz öğeleri (kod tarafından eklenir) -->
                            <ItemsControl x:Name="PeerItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="peerCard"
                                                Background="Transparent"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10" Padding="12,10"
                                                Margin="0,3" Cursor="Hand"
                                                MouseDown="PeerCard_Click"
                                                Tag="{Binding}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F0F4FF"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Hostname}" FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding IP}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecBrush}"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                               Foreground="{DynamicResource SuccessBrush}"
                                                               Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <!-- Seçili göstergesi -->
                                                <TextBlock Text="→" FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Sağ Taraf: IP + Kendi Bilgi ─────────────────────────── -->
            <StackPanel Grid.Column="2" VerticalAlignment="Stretch">

                <!-- Kendi IP kartı -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Bu Bilgisayarın IP Adresi" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtMyIP" Text="—" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock x:Name="TxtHostname" Text="" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource DropZoneHighlightBrush}" CornerRadius="8"
                                Padding="10,6" VerticalAlignment="Center">
                            <TextBlock Text="📋 Paylaş" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Cursor="Hand" MouseDown="CopyIP_Click"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Hedef IP (manuel giriş veya cihaz seçilince otomatik dolar) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="16,12">
                    <StackPanel>
                        <TextBlock x:Name="TxtTargetLabel" Text="Hedef Cihaz"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecBrush}" Margin="0,0,0,8"/>

                        <!-- Seçili Cihaz -->
                        <Border x:Name="SelectedPeerCard" Visibility="Collapsed"
                                Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource SuccessBrush}"
                                BorderThickness="1.5" CornerRadius="8" Padding="12,8">
                            <Grid>
                                <StackPanel>
                                    <TextBlock x:Name="TxtSelectedPeerName" FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock x:Name="TxtSelectedPeerIP" FontSize="11"
                                               Foreground="{DynamicResource TextSecBrush}"/>
                                </StackPanel>
                                <Button Style="{DynamicResource IconButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="BtnClearPeer_Click"
                                        ToolTip="Seçimi kaldır">
                                    <TextBlock Text="✕" FontSize="12"
                                               Foreground="{DynamicResource TextSecBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Manuel IP girişi -->
                        <Grid x:Name="ManualIPPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtTargetIP" Grid.Column="0"
                                     Style="{DynamicResource ModernTextBox}"
                                     FontSize="13" FontWeight="Bold"
                                     ToolTip="Sol listeden cihaz seçin veya IP girin"/>
                            <Button x:Name="BtnTestConn" Grid.Column="1" Content="Test"
                                    Style="{DynamicResource SecondaryButton}"
                                    Padding="12,8" FontSize="12" Margin="8,0,0,0"
                                    Click="BtnTestConn_Click"/>
                        </Grid>
                        <TextBlock x:Name="TxtConnStatus" Text="" FontSize="11"
                                   Foreground="{DynamicResource TextSecBrush}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ═══ 4. DROP ZONE ════════════════════════════════════════════════ -->
        <Border Grid.Row="3" x:Name="DropZone"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2"
                CornerRadius="12" AllowDrop="True"
                DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                Drop="DropZone_Drop" MouseDown="DropZone_MouseDown"
                Margin="0,0,0,12" Cursor="Hand">

            <Grid>
                <!-- Boş State -->
                <StackPanel x:Name="DropHint" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Margin="0,30,0,30">
                    <Border Background="{DynamicResource DropZoneHighlightBrush}" Width="64" Height="64" CornerRadius="18"
                            HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="📂" FontSize="32" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Dosyaları sürükleyip bırakın" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="veya tıklayarak seçin — sınırsız dosya" FontSize="12"
                               Foreground="{DynamicResource TextSecBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,20"/>
                    <Button Content="Dosya Seç" Style="{DynamicResource SecondaryButton}"
                            Padding="20,10" FontSize="13" HorizontalAlignment="Center"
                            Click="BtnBrowse_Click"/>
                </StackPanel>

                <!-- Dosya Listesi State -->
                <Grid x:Name="FileListPanel" Visibility="Collapsed" Margin="18,14,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Özet + Butonlar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="✓" FontSize="12" Foreground="{DynamicResource SuccessBrush}"
                                           FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TxtFileCount" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="+ Ekle" Style="{DynamicResource SecondaryButton}"
                                    Padding="10,5" FontSize="12" Margin="0,0,8,0"
                                    Click="BtnBrowse_Click"/>
                            <Button Content="Temizle" Style="{DynamicResource DangerButton}"
                                    Padding="10,5" FontSize="12"
                                    Click="BtnClearFiles_Click"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FileListControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Surface2Brush}"
                                            CornerRadius="8" Margin="0,3" Padding="12,8"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="13" Margin="0,0,8,0"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11"
                                                               Foreground="{DynamicResource TextSecBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Content="✕" Style="{DynamicResource IconButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Width="26" Height="26" Padding="4" FontSize="10"
                                                    Tag="{Binding}" Click="BtnRemoveFile_Click"
                                                    Foreground="{DynamicResource DangerBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="Daha fazla dosya eklemek için buraya sürükleyin"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 5. İLERLEME ════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="TxtTransferFile" Text="Bekleniyor..." FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtPercent" Text="0%" FontSize="13" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="PbTransfer" Style="{DynamicResource ModernProgress}"
                             Value="0" Maximum="100" Margin="0,0,0,6"/>
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Hız: " FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        <TextBlock x:Name="TxtSpeed" Text="—" FontSize="11"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Kalan: " FontSize="11" Foreground="{DynamicResource TextSecBrush}"/>
                        <TextBlock x:Name="TxtRemaining" Text="—" FontSize="11"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══ 6. AKSİYON ════════════════════════════════════════════════ -->
        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtNetStatus" Text="" FontSize="12"
                           Foreground="{DynamicResource SuccessBrush}"/>
                <ScrollViewer x:Name="LogScroll" Height="0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtLog"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtSavePath" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnCancel" Content="İptal"
                        Style="{DynamicResource SecondaryButton}"
                        Width="90" Margin="0,0,10,0"
                        Click="BtnCancel_Click" IsEnabled="False"/>
                <Button x:Name="BtnSend" Content="🚀 Gönder"
                        Style="{DynamicResource PrimaryButton}"
                        Width="130" Click="BtnSend_Click" IsEnabled="False"/>
                <Button x:Name="BtnReceive" Content="📥 Almaya Başla"
                        Style="{DynamicResource SuccessButton}"
                        Width="150" Click="BtnReceive_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
