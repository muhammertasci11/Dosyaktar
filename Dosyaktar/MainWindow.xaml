<Window x:Class="Dosyaktar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dosyaktar" Height="750" Width="1100"
        MinHeight="700" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Icon="Assets/icon.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Closing="Window_Closing">

    <Window.Resources>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Border Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource BorderBrush}">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PeerCardTemplate">
            <Border Style="{StaticResource GlassPanelBorder}" Padding="20" Margin="0,0,16,16" Cursor="Hand" Width="380">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Width="48" Height="48" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Margin="0,0,16,0">
                            <TextBlock Text="💻" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                        </Border>
                        
                        <Border Grid.Column="2" Background="{DynamicResource SuccessBrush}" Opacity="0.2" CornerRadius="6" VerticalAlignment="Top" Padding="8,4">
                            <TextBlock Text="{Binding IpAddress}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" FontSize="11" />
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,16">
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="20" Margin="0,0,0,4"/>
                        <TextBlock Text="Cihaz • Local Network" Foreground="{DynamicResource TextSecBrush}" FontSize="13"/>
                    </StackPanel>

                    <Button Grid.Row="2" Style="{StaticResource GlassPanelButton}" Content="🔗 Bağlan" Tag="{Binding}" Click="BtnSendToPeer_Click"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/> <!-- Sidebar -->
                <ColumnDefinition Width="*"/>   <!-- Main Area -->
                <ColumnDefinition Width="320"/> <!-- Right Panel -->
            </Grid.ColumnDefinitions>

        <!-- Dummy Elements for Legacy C# Code Compatibility -->
        <Grid x:Name="LegacyDummies" Visibility="Collapsed" Grid.Column="0">
            <TextBlock x:Name="TxtConnStatus"/>
            <Button x:Name="BtnSend"/>
            <RadioButton x:Name="RbSender"/>
            <RadioButton x:Name="RbReceiver"/>
            <Grid x:Name="SelectedPeerCard"/>
            <Grid x:Name="ManualIPPanel"/>
            <TextBlock x:Name="TxtScanning"/>
            <TextBlock x:Name="TxtMyIP"/>
            <TextBlock x:Name="TxtTargetIP"/>
            <TextBlock x:Name="TxtNetStatus"/>
            <Button x:Name="BtnTestConn"/>
            <Grid x:Name="PairingModal"/>
            
            <ListBox x:Name="FileListControl"/>
            <TextBlock x:Name="NoPeersHint"/>
            <Border x:Name="PeerCountBadge"/>
            <TextBlock x:Name="TxtPeerCount"/>
            <TextBlock x:Name="TxtSelectedPeerName"/>
            <TextBlock x:Name="TxtSelectedPeerIP"/>
        </Grid>

        <!-- Background radar pulse animation container -->
        <Canvas x:Name="RadarCanvas" IsHitTestVisible="False" Grid.Column="0" Grid.ColumnSpan="3">
            <Ellipse x:Name="RadarCircle1" Width="0" Height="0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" Opacity="0"/>
        </Canvas>

        <!-- ==============================================
             LEFT SIDEBAR
             ============================================== -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20" CornerRadius="16,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,30" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock Text="Dosyaktar" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="24"/>
                    <TextBlock Text="Local High-Speed" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Content="Keşif" Tag="&#xE721;" Style="{StaticResource SidebarTabButton}" IsChecked="True" Click="MenuDiscovery_Click"/>
                    <RadioButton Content="Aktif Oturum" Tag="&#xE8CC;" Style="{StaticResource SidebarTabButton}" Click="MenuActiveSession_Click"/>
                    <RadioButton Content="Geçmiş" Tag="&#xE81C;" Style="{StaticResource SidebarTabButton}" Click="MenuHistory_Click"/>
                    
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,20" Opacity="0.5"/>
                    <RadioButton Content="Ayarlar" Tag="&#xE713;" Style="{StaticResource SidebarTabButton}" Click="MenuSettings_Click"/>
                </StackPanel>

                <Button x:Name="BtnPairDevice" Grid.Row="2" Style="{StaticResource GradientButton}" Click="MenuPair_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Cihaz Eşleştir" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ==============================================
             MAIN AREA
             ============================================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Main Header -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <TextBlock x:Name="TxtHeaderTitle" Text="Keşif Modu" Foreground="{DynamicResource AccentBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0" x:Name="ElScanIndicator"/>
                        <TextBlock Text="Yerel ağ taranıyor..." Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        
                        <Button Style="{StaticResource IconButton}" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Click="BtnRefresh_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE921;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="8,0,0,0" Click="BtnMinimize_Click"/>
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="8,0,0,0" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Panels -->
            <Grid Grid.Row="1" Margin="32">
                <!-- KEŞİF MODU PANELİ -->
                <Grid x:Name="PanelDiscovery">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,32">
                        <TextBlock Text="Yakındaki Cihazlar" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock Text="Mevcut WiFi alt ağındaki eşler aranıyor. Bağlantı istemek için dokunun." FontSize="15" Foreground="{DynamicResource TextSecBrush}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PeerList" ItemTemplate="{StaticResource PeerCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- AKTİF OTURUM PANELİ -->
                <Grid x:Name="PanelActive" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,40" HorizontalAlignment="Center">
                        <TextBlock Text="Aktif Oturum" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"/>
                        <TextBlock Text="Yüksek hızlı veri transferi aktif." FontSize="14" Foreground="{DynamicResource TextSecBrush}" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Device Connection Visual -->
                    <Grid Grid.Row="1" Margin="0,0,0,40" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- My Device -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" Style="{StaticResource GlassPanelBorder}">
                                <TextBlock Text="💻" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" Margin="0,12,0,4" HorizontalAlignment="Center">
                                <TextBlock Text="BU CİHAZ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock x:Name="TxtMyDeviceName" Text="Bilgisayarım" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Transfer Arrow -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="⇄" FontSize="28" Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtLiveSpeed" Text="Bağlı" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Target Device -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <Border Width="100" Height="100" Style="{StaticResource GlassPanelBorder}">
                                <TextBlock Text="📱" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="4" Padding="6,2" Margin="0,12,0,4" HorizontalAlignment="Center">
                                <TextBlock Text="HEDEF" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock x:Name="TxtTargetDeviceName" Text="Hedef Cihaz" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- Drop Zone -->
                    <Border Grid.Row="2" x:Name="DropZoneBorder" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="20" AllowDrop="True" Drop="Border_Drop" DragEnter="Border_DragEnter" DragLeave="Border_DragLeave">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8D5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="48" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="Dosya veya oyun göndermek için sürükleyip bırakın" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Veya yerel depolamanızdan gözatın" FontSize="13" Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                            
                            <Button Style="{StaticResource GlassPanelButton}" Width="180" Click="BtnGameTransfer_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE909;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Oyun Gönder" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- GEÇMİŞ PANELİ -->
                <Grid x:Name="PanelHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <TextBlock Text="Transfer Geçmişi" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        <Grid HorizontalAlignment="Left">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="350" Padding="36,10,12,10" Text="Dosya adı, türü veya tarih ile ara..."/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Table Header -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="16,0,16,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="DOSYA ADI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="BOYUT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="TARİH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="DURUM" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <ScrollViewer Grid.Row="1">
                            <StackPanel x:Name="HistoryList">
                                <TextBlock Text="Henüz bir transfer geçmişi yok." Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- AYARLAR PANELİ -->
                <Grid x:Name="PanelSettings" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,16,24">
                            <!-- UYGULAMA TEMASI -->
                            <TextBlock Text="Uygulama Teması" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Görünümü tarzınıza göre özelleştirin." FontSize="13" Foreground="{DynamicResource TextSecBrush}" Margin="0,0,0,16"/>
                            
                            <WrapPanel x:Name="ThemeWrapPanel" Orientation="Horizontal" Margin="0,0,0,32">
                                <Border Style="{StaticResource GlassPanelBorder}" Width="120" Height="110" Margin="0,0,12,12" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="nordic">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="6,6,6,0" CornerRadius="6" Background="#E6F0FA"/>
                                        <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                            <TextBlock Text="Nordic Frost" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#1E40AF" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#93C5FD" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#EFF6FF"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassPanelBorder}" Width="120" Height="110" Margin="0,0,12,12" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="cyberpunk">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="6,6,6,0" CornerRadius="6" Background="#170F24"/>
                                        <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                            <TextBlock Text="Cyberpunk" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#E879F9" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#2DD4BF" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#0F172A"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassPanelBorder}" Width="120" Height="110" Margin="0,0,12,12" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="forest">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="6,6,6,0" CornerRadius="6" Background="#14532D"/>
                                        <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                            <TextBlock Text="Deep Forest" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#166534" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#4ADE80" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#86EFAC"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassPanelBorder}" Width="120" Height="110" Margin="0,0,12,12" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="crimson">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="6,6,6,0" CornerRadius="6">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#312E81" Offset="0"/><GradientStop Color="#4C1D95" Offset="1"/></LinearGradientBrush></Border.Background>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                            <TextBlock Text="Crimson Slate" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#7C3AED" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#A78BFA" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#1E1B4B"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource GlassPanelBorder}" Width="120" Height="110" Margin="0,0,12,12" Cursor="Hand" MouseDown="ThemeCard_Click" Tag="sunset">
                                    <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Margin="6,6,6,0" CornerRadius="6">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F97316" Offset="0"/><GradientStop Color="#FCA5A5" Offset="1"/></LinearGradientBrush></Border.Background>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="8,6,8,8">
                                            <TextBlock Text="Sunset Breeze" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0"><Ellipse Width="7" Height="7" Fill="#EA580C" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#FB923C" Margin="0,0,3,0"/><Ellipse Width="7" Height="7" Fill="#FED7AA"/></StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </WrapPanel>

                            <!-- CİHAZ BİLGİLERİ -->
                            <Border Style="{StaticResource GlassPanelBorder}" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Cihaz Bilgileri" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="CİHAZ ADI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="TxtHostname" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" LostFocus="Setting_Changed"/>

                                    <TextBlock Text="PORT NUMARASI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <TextBox x:Name="TxtPort" Style="{StaticResource ModernTextBox}" Text="5001" Margin="0,0,0,16" LostFocus="Setting_Changed"/>
                                </StackPanel>
                            </Border>

                            <!-- İNDİRME AYARLARI -->
                            <Border Style="{StaticResource GlassPanelBorder}" Padding="24" Margin="0,0,0,16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="İndirme Ayarları" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="İNDİRME KLASÖRÜ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtDownloadFolder" Style="{StaticResource ModernTextBox}" Grid.Column="0" Margin="0,0,12,0" LostFocus="Setting_Changed"/>
                                        <Button Grid.Column="1" Content="Gözat" Style="{StaticResource GlassPanelButton}" Width="80" Click="BtnBrowseFolder_Click"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Otomatik Kabul Et" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,2"/>
                                            <TextBlock Text="Tanıdık cihazlardan gelenleri sorma" Foreground="{DynamicResource TextSecBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoReceive" Style="{StaticResource ToggleSwitch}" Grid.Column="1" VerticalAlignment="Center" Click="Setting_Changed"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Otomatik Güncelleme" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,2"/>
                                            <TextBlock Text="Yeni sürümler otomatik indirilsin" Foreground="{DynamicResource TextSecBrush}" FontSize="12"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ChkAutoUpdate" Style="{StaticResource ToggleSwitch}" IsChecked="True" Grid.Column="1" VerticalAlignment="Center" Click="Setting_Changed"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- DANGER ZONE -->
                            <Border BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Uygulama Verilerini Temizle" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,0,0,4"/>
                                        <TextBlock Text="Tüm geçmişi ve ayarları sıfırlayarak uygulamayı baştan başlatın." Foreground="{DynamicResource TextSecBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Sıfırla" Background="{DynamicResource DangerBrush}" Foreground="White" BorderThickness="0" Padding="24,10" FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==============================================
             RIGHT PANEL (QUEUE / NETWORK)
             ============================================== -->
        <Border x:Name="QueuePanel" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" CornerRadius="0,16,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <TextBlock x:Name="TxtRightPanelTitle" Text="Aktarım Kuyruğu" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <!-- Empty State -->
                <StackPanel x:Name="QueueEmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="80" Height="80" Background="{DynamicResource Surface2Brush}" CornerRadius="40" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="32" Foreground="{DynamicResource BorderBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Aktif aktarım yok" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Dosyaları yerel ışık hızında taşımaya&#x0a;başlamak için bir cihaza bağlanın." FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center"/>
                </StackPanel>

                <!-- Active Transfer State -->
                <ScrollViewer x:Name="QueueActiveState" Grid.Row="1" Visibility="Collapsed" Padding="16">
                    <StackPanel>
                        <!-- Example Active Transfer Card -->
                        <Border x:Name="TransferCard" Style="{StaticResource GlassPanelBorder}" Padding="16" Margin="0,0,0,12" Background="#111827">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="{DynamicResource PrimaryGradientBrush}" CornerRadius="8" Margin="0,0,12,0">
                                        <TextBlock Text="&#xE898;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtQueueFileName" Text="Dosyalar Gönderiliyor" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                        <TextBlock x:Name="TxtQueueFileSize" Text="Hesaplanıyor..." Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/>
                                    </StackPanel>
                                    <Button x:Name="BtnCancelTransfer" Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Click="BtnCancelTransfer_Click"/>
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtQueueSpeed" Text="-- MB/s" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtQueueProgress" Text="--%" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>

                                <ProgressBar x:Name="TransferProgressBar" Grid.Row="2" Height="4" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource ProgressGradientBrush}" BorderThickness="0" Value="45"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Network Info Box -->
                <Border Grid.Row="2" Margin="24,0,24,24" Style="{StaticResource GlassPanelBorder}" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Ağ Durumu" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtNetworkType" Text="Gigabit LAN" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Height="4" Background="{DynamicResource SurfaceBrush}" CornerRadius="2">
                            <Border x:Name="NetSpeedBar" HorizontalAlignment="Left" Width="200" Background="{DynamicResource SuccessBrush}" CornerRadius="2"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Status Footer -->
                <Border Grid.Row="3" Background="{DynamicResource BackgroundBrush}" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock Text="Dosyaktar v1.7.2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFooterStatus" Text="Bağlı" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
    </Border>
</Window>
