<UserControl x:Class="Dosyaktar.Views.GameLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <UserControl.Resources>
        <!-- ListBoxItem style for game cards: transparent, no chrome, focus ring -->
        <Style x:Key="GameListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                CornerRadius="20"
                                Background="{DynamicResource GlassStrongBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                Effect="{DynamicResource SoftShadow}"
                                Padding="0"
                                RenderTransformOrigin="0.5,0.5">
                            <Grid>
                                <Border x:Name="FocusRing"
                                        CornerRadius="20"
                                        BorderThickness="1.5"
                                        BorderBrush="{DynamicResource AccentInkBrush}"
                                        Margin="-1.5"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False"/>
                                <ContentPresenter/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource AccentGhostBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Game card DataTemplate -->
        <DataTemplate x:Key="GameCardTemplate">
            <Border Width="204" Height="176" CornerRadius="20" ClipToBounds="True">
                <Grid>
                    <!-- Cover area: tinted fallback (provider tint + Initial) underneath, Image on top -->
                    <Grid x:Name="CoverGrid" Height="104" VerticalAlignment="Top">
                        <!-- Fallback tint + Initial (always present, shows through when Cover is null) -->
                        <Border x:Name="tint"
                                Background="{DynamicResource AccentSoftBrush}"
                                CornerRadius="14,14,0,0">
                            <TextBlock x:Name="TxtInitial"
                                       Text="{Binding Initial}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Cover image on top - transparent when Source is null, revealing tint underneath -->
                        <Image x:Name="ImgCover"
                               Source="{Binding Cover}"
                               Stretch="UniformToFill"
                               Margin="0"/>

                        <!-- Provider badge bottom-left -->
                        <Border VerticalAlignment="Bottom"
                                HorizontalAlignment="Left"
                                Margin="10,0,0,10"
                                CornerRadius="12"
                                Padding="7,3"
                                Background="#CC0B0D12"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="{Binding ProviderName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Size chip top-right -->
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Right"
                                Margin="0,8,8,0"
                                CornerRadius="10"
                                Padding="7,2"
                                Background="#CC0B0D12"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1">
                            <TextBlock Text="{Binding SizeText}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>

                        <!-- Selection check glyph top-left -->
                        <Border x:Name="SelectionGlyph"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="{DynamicResource AccentFillBrush}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="8,8,0,0"
                                Visibility="Collapsed">
                            <TextBlock Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="10"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Info below cover -->
                    <StackPanel Margin="10,108,10,10">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="20"/>
                        <TextBlock Text="{Binding FolderName}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- Provider tint via DataTriggers on ProviderId -->
                <DataTrigger Binding="{Binding ProviderId}" Value="steam">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource SteamTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="epic">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource EpicTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="gog">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource GogTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="battlenet">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource BattleNetTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="ubisoft">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource UbisoftTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="ea">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource EaTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="riot">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource RiotTintBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ProviderId}" Value="folder">
                    <Setter TargetName="tint" Property="Background" Value="{DynamicResource FolderTintBrush}"/>
                </DataTrigger>

                <!-- Selection glyph visibility via RelativeSource to ListBoxItem.IsSelected -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="SelectionGlyph" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Skeleton card for scan state -->
        <DataTemplate x:Key="SkeletonCardTemplate">
            <Border Width="204" Height="176" CornerRadius="20" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filter row -->
            <RowDefinition Height="*"/>    <!-- Body: grid + detail rail -->
        </Grid.RowDefinitions>

        <!-- ───────────────────────── HEADER ───────────────────────── -->
        <Grid Margin="18,18,18,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Oyun Kütüphanesi"
                           Style="{StaticResource DisplayText}"
                           FontSize="25"/>
            </StackPanel>

            <TextBlock x:Name="TxtSummary"
                       Grid.Column="1"
                       Style="{StaticResource MutedText}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Text="28 oyun · 4 sağlayıcı · 512 GB"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRefresh"
                        Style="{StaticResource GhostButton}"
                        Padding="12,9"
                        Click="BtnRefresh_Click"
                        ToolTip="Tarama yap">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Yenile"
                                   FontSize="13"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="face" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
                                    <Setter TargetName="face" Property="BorderThickness" Value="1.5"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource AccentGhostBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentInkBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="BtnAddFolder"
                        Style="{StaticResource SecondaryButton}"
                        FontSize="13"
                        Padding="16,11"
                        Margin="8,0,0,0"
                        Click="BtnAddFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Klasör ekle"
                                   FontSize="13"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───────────────────────── FILTER ROW ───────────────────────── -->
        <Border Grid.Row="1"
                Margin="18,0,18,12"
                Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox x:Name="TxtSearch"
                         Style="{StaticResource ModernTextBox}"
                         Tag="Oyun ara"
                         Width="260"
                         VerticalAlignment="Center"
                         TextChanged="TxtSearch_TextChanged"
                         KeyDown="TxtSearch_KeyDown">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="face" CornerRadius="11"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE721;"
                                               FontFamily="{StaticResource IconFont}"
                                               FontSize="14"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="13,0,8,0"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Grid.Column="1"
                                                  Margin="0,10"
                                                  VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ph"
                                               Grid.Column="1"
                                               Text="{TemplateBinding Tag}"
                                               Margin="0,10"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="face" Property="BorderBrush" Value="{DynamicResource AccentInkBrush}"/>
                                    <Setter TargetName="face" Property="BorderThickness" Value="1.5"/>
                                    <Setter TargetName="face" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Provider chips -->
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              Margin="16,0,16,0"
                              Padding="0,2,0,2">
                    <StackPanel x:Name="ChipPanel" Orientation="Horizontal">
                        <RadioButton x:Name="ChipAll" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Hepsi" Tag="all" IsChecked="True" Checked="Provider_Checked"/>
                        <RadioButton x:Name="ChipSteam" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Steam" Tag="steam" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipEpic" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Epic" Tag="epic" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipGog" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="GOG" Tag="gog" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipBattleNet" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Battle.net" Tag="battlenet" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipUbisoft" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Ubisoft" Tag="ubisoft" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipEa" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="EA" Tag="ea" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipRiot" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Riot" Tag="riot" Checked="Provider_Checked" Margin="8,0,0,0"/>
                        <RadioButton x:Name="ChipFolder" GroupName="gamefilter" Style="{StaticResource TabRadioButton}" Content="Klasör" Tag="folder" Checked="Provider_Checked" Margin="8,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Size progress -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="SizeProgress"
                                 Style="{StaticResource ModernProgress}"
                                 Width="140"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="False"
                                 Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtSizeProgress"
                               Style="{StaticResource MutedText}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Text="Boyutlar hesaplanıyor… 7/28"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ───────────────────────── BODY ───────────────────────── -->
        <Grid Grid.Row="2" Margin="18,0,18,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Game grid -->
            <Grid Grid.Column="0" x:Name="GameGridHost">
                <!-- Scan state (skeleton) -->
                <Border x:Name="ScanState" Visibility="Collapsed">
                    <StackPanel>
                        <ItemsControl ItemTemplate="{StaticResource SkeletonCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" ItemWidth="204" ItemHeight="176"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <sys:String>1</sys:String>
                            <sys:String>2</sys:String>
                            <sys:String>3</sys:String>
                            <sys:String>4</sys:String>
                            <sys:String>5</sys:String>
                            <sys:String>6</sys:String>
                        </ItemsControl>
                        <TextBlock x:Name="TxtScanStatus"
                                   Style="{StaticResource MutedText}"
                                   Text="Oyunlar taranıyor…"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Empty state (no games at all) -->
                <Border x:Name="EmptyState" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Faceted icon with accent gradient -->
                        <Border Width="80" Height="80" CornerRadius="20" Margin="0,0,0,24">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource Accent2Color}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Polygon Points="40,10 70,35 70,65 40,90 10,65 10,35"
                                         Fill="White" Opacity="0.9"/>
                                <Ellipse Width="24" Height="24"
                                         Fill="{DynamicResource AccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Oyun bulunamadı"
                                   Style="{StaticResource SectionText}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Steam ve Epic kütüphaneleri otomatik taranır. Diğer sağlayıcılar veya özel konumlar için bir klasör ekleyin."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   MaxWidth="360"
                                   Margin="0,8,0,20"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource SecondaryButton}"
                                Padding="16,11"
                                Click="BtnAddFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="13"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Klasör ekle"
                                           FontSize="13"
                                           Margin="7,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- No results (filter hides everything) -->
                <Border x:Name="NoResults" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Bu filtreye uyan oyun yok"
                                   Style="{StaticResource SectionText}"
                                   FontSize="17"
                                   HorizontalAlignment="Center"/>
                        <Button x:Name="BtnClearFilter"
                                Style="{StaticResource GhostButton}"
                                Content="Filtreyi temizle"
                                Margin="0,12,0,0"
                                Click="BtnClearFilter_Click"/>
                    </StackPanel>
                </Border>

                <!-- Game list -->
                <ListBox x:Name="GameList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ItemContainerStyle="{StaticResource GameListItemStyle}"
                         ItemTemplate="{StaticResource GameCardTemplate}"
                         SelectionChanged="GameList_SelectionChanged"
                         Visibility="Visible">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="204" ItemHeight="176"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Grid>

            <!-- RIGHT: Detail rail (fixed 300px) -->
            <Border x:Name="DetailPanel"
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Background="{DynamicResource GlassStrongBrush}"
                    BorderBrush="{DynamicResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Effect="{DynamicResource CardShadow}">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Filled detail state (initially collapsed) -->
                        <StackPanel x:Name="DetailFilled" Visibility="Collapsed">
                            <!-- Cover -->
                            <Border x:Name="DetailCover"
                                    Width="264" Height="150"
                                    CornerRadius="16"
                                    ClipToBounds="True"
                                    HorizontalAlignment="Center">
                                <Grid>
                                    <Border x:Name="DetailCoverFallback"
                                            Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock x:Name="TxtDetailInitial"
                                                   Text="?"
                                                   FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="44"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Image x:Name="ImgDetailCover"
                                           Source="{Binding Cover}"
                                           Stretch="UniformToFill"/>
                                </Grid>
                            </Border>

                            <!-- Name -->
                            <TextBlock x:Name="TxtDetailName"
                                       Text="{Binding Name}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,14,0,2"
                                       HorizontalAlignment="Center"/>

                            <!-- Provider + install dir -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <Border x:Name="DetailProviderDot"
                                        Width="8" Height="8"
                                        CornerRadius="4"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentSoftBrush}"
                                        Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtDetailProvider"
                                           Style="{StaticResource MutedText}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           MaxWidth="260"/>
                            </StackPanel>

                            <!-- Size -->
                            <TextBlock x:Name="TxtDetailSize"
                                       Text="{Binding SizeText}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentInkBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,4"/>

                            <!-- Last played -->
                            <TextBlock x:Name="TxtDetailPlayed"
                                       Text="{Binding LastPlayedText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11.5"
                                       HorizontalAlignment="Center"/>

                            <!-- Install path -->
                            <TextBlock x:Name="TxtDetailPath"
                                       Text="{Binding InstallPath}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11.5"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260"
                                       ToolTip="{Binding InstallPath}"
                                       Margin="0,10,0,4"/>

                            <!-- Steam manifest note -->
                            <TextBlock x:Name="TxtDetailNote"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       MaxWidth="260"
                                       Margin="0,0,0,16"
                                       Visibility="Collapsed"/>

                            <Border Style="{StaticResource DividerLine}"/>

                            <!-- Actions -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="BtnSendGame"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="Gönder"
                                        Padding="20,11"
                                        IsEnabled="False"
                                        Click="BtnSendGame_Click"/>
                                <Button x:Name="BtnLaunchGame"
                                        Style="{StaticResource SecondaryButton}"
                                        Content="Başlat"
                                        Padding="16,11"
                                        Margin="8,0,0,0"
                                        Click="BtnLaunchGame_Click"/>
                                <Button x:Name="BtnOpenGameFolder"
                                        Style="{StaticResource GhostButton}"
                                        Content="Klasörü aç"
                                        Padding="12,9"
                                        Margin="8,0,0,0"
                                        Click="BtnOpenGameFolder_Click"/>
                            </StackPanel>

                            <!-- How it works expander -->
                            <Expander Header="Nasıl çalışır?" Margin="0,16,0,0" IsExpanded="False">
                                <StackPanel Margin="4,8,0,0">
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="• Steam oyunları: "/>
                                        <Run Text="Alıcı bilgisayarda steamapps/common içine yerleştirilir ve manifest (appmanifest_&lt;appid&gt;.acf) kayıt altına alınır; Steam yeniden başlatıldığında kütüphanede görünür."/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8">
                                        <Run Text="• Epic oyunları: "/>
                                        <Run Text="Klasör kopyalanır; Epic Launcher'da 'Doğrula' seçeneğiyle kayıt tamamlanabilir."/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap">
                                        <Run Text="• Diğer sağlayıcılar (GOG, Battle.net, Ubisoft, EA, Riot): "/>
                                        <Run Text="Oyun klasörü olduğu gibi kopyalanır; başlatıcıya manuel eklenmesi gerekebilir."/>
                                    </TextBlock>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Empty detail state -->
                    <StackPanel x:Name="DetailEmpty" VerticalAlignment="Center" Visibility="Visible">
                        <TextBlock Text="Bir oyun seç"
                                   Style="{StaticResource SectionText}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Listeden bir oyuna tıklayın. Gönder, başlat veya klasörü aç."
                                   Style="{StaticResource MutedText}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="260"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>

        <!-- Warning banner -->
        <Border x:Name="TxtWarn"
                Grid.Row="2"
                Margin="18,0,18,18"
                Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerInkBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Visibility="Collapsed">
            <TextBlock Foreground="{DynamicResource DangerInkBrush}"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Text="Bir hata oluştu. Detaylar için geçmişe bakın."/>
        </Border>

    </Grid>
</UserControl>