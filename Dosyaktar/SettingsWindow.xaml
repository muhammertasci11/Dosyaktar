<Window x:Class="Dosyaktar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Height="560" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecBrush}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="WindowCloseBtn" TargetType="Button" BasedOn="{StaticResource WindowControlBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource BackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ Custom Title Bar ═══ -->
            <Grid Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="⚙" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Text_Settings}" Foreground="{DynamicResource TextSecBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="✕" Style="{StaticResource WindowCloseBtn}" Click="BtnCloseWindow_Click"/>
                </StackPanel>
            </Grid>

            <!-- ═══ Main Content Area ═══ -->
            <Grid Grid.Row="1" Margin="32,28,32,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Başlık -->
                    <RowDefinition Height="*"/>     <!-- İçerik -->
                    <RowDefinition Height="Auto"/>  <!-- Kaydet/İptal -->
                </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,22">
            <Border Width="36" Height="36" Background="{DynamicResource AccentBrush}"
                    CornerRadius="10" Margin="0,0,12,0">
                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Text_Settings}" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Text_SettingsDesc}"
                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- İçerik -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ── Kayıt Klasörü ──────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text_SetSaveDir}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Text_SetSaveDirDesc}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Surface2Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    CornerRadius="8" Padding="12,9">
                                <TextBlock x:Name="TxtSaveDir" FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Border>
                            <Button Grid.Column="1" Content="Göz At"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,9" FontSize="12" Margin="8,0,0,0"
                                    Click="BtnBrowseDir_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Port ──────────────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Text_SetPort}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Text_SetPortDesc}"
                                   FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Border Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                CornerRadius="8" Padding="12,6" Width="160" HorizontalAlignment="Left">
                            <TextBox x:Name="TxtPort" FontSize="13" BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Dil Seçimi ────────────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🌐  Dil (Language)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Text_SetLang}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{DynamicResource Text_SetLangDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="CmbLanguage" Grid.Column="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="Türkçe" Tag="tr" IsSelected="True" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Görünüm ────────────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🎨  Görünüm" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Text_SetDarkMode}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{DynamicResource Text_SetDarkModeDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkDarkMode" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"
                                      Checked="ChkDarkMode_Changed"
                                      Unchecked="ChkDarkMode_Changed"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Güncelleme ─────────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🔄  Güncelleme" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <!-- Güncelleme Kontrol -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Text_SetAutoUpdate}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="{DynamicResource Text_SetAutoUpdateDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkUpdates" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                        <!-- Otomatik Güncelle -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Text_SetAutoBgUpdate}" FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="4"
                                            Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="ÖNERİLİR" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Text_SetAutoBgUpdateDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoUpdate" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Uygulama ───────────────────────────────────────────── -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="⚡  Uygulama" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Otomatik alma modu" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Uygulama açılınca dosya beklemeye başlar"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAutoReceive" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Ağ Sorun Giderme ────────────────────────────────────── -->
                <Border Background="#1A10B981"
                        BorderBrush="#3310B981" BorderThickness="1"
                        CornerRadius="12" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="🛡  Ağ Sorun Giderme" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#10B981" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Güvenlik Duvarı İzinlerini Onar" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium"/>
                                <TextBlock Text="Ethernet üzerinden cihazlar birbirini bulamıyorsa bu tuşa basın. (Yönetici izni gerektirir)"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Onar"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="14,9" FontSize="12" VerticalAlignment="Center"
                                    Click="BtnFixFirewall_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Alt Bilgi -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <TextBlock x:Name="TxtVersion" FontSize="11"
                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
    </Grid>
    </Border>
</Window>
