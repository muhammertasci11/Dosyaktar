<Window x:Class="Dosyaktar.GameTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎮 Oyun / Uygulama Taşı" Height="620" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Başlık -->
            <RowDefinition Height="Auto"/>   <!-- Platform Tab -->
            <RowDefinition Height="*"/>      <!-- İçerik -->
            <RowDefinition Height="Auto"/>   <!-- İlerleme -->
            <RowDefinition Height="Auto"/>   <!-- Butonlar -->
        </Grid.RowDefinitions>

        <!-- ═══ BAŞLIK ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🎮 Oyun / Uygulama Taşıma" FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Oyun ve uygulamaları internet harcamadan arkadaşına gönder"
                           FontSize="12" Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource TextSecBrush}"/>
        </Grid>

        <!-- ═══ PLATFORM SEKMELERİ ══════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8" Padding="4" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabSteam"   Content="🎮 Steam"    GroupName="Platform"
                             IsChecked="True" Checked="Platform_Changed"
                             Style="{DynamicResource TabRadioButton}" Margin="0,0,4,0"/>
                <RadioButton x:Name="TabEpic"    Content="⚡ Epic Games" GroupName="Platform"
                             Checked="Platform_Changed"
                             Style="{DynamicResource TabRadioButton}" Margin="0,0,4,0"/>
                <RadioButton x:Name="TabFolder"  Content="📁 Klasör"   GroupName="Platform"
                             Checked="Platform_Changed"
                             Style="{DynamicResource TabRadioButton}" Margin="0,0,4,0"/>
                <RadioButton x:Name="TabExe"     Content="⚙ Uygulama (Exe)"  GroupName="Platform"
                             Checked="Platform_Changed"
                             Style="{DynamicResource TabRadioButton}"/>
            </StackPanel>
        </Border>

        <!-- ═══ İÇERİK ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">

            <!-- Steam / Epic Game Listesi -->
            <Grid x:Name="PanelGameList">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Üst bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtGameStatus" FontSize="13"
                                   Foreground="{DynamicResource TextSecBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="🔄 Yenile" Style="{DynamicResource SecondaryButton}"
                            HorizontalAlignment="Right" Padding="12,6" FontSize="12"
                            Click="BtnRefresh_Click"/>
                </Grid>

                <!-- Oyun Listesi -->
                <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                        CornerRadius="8" Padding="0">
                    <ListView x:Name="GameListView" Background="Transparent"
                              BorderThickness="0" SelectionMode="Single"
                              SelectionChanged="GameListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background"   Value="Transparent"/>
                                <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="Padding"      Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1AFFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#334F8EF7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding InstallPath}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecBrush}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Seçili oyun bilgisi -->
                <Border Grid.Row="2" x:Name="SelectedGameInfo" Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}" CornerRadius="8"
                        Padding="16,10" Margin="0,10,0,0">
                    <Grid>
                        <StackPanel>
                            <TextBlock x:Name="TxtSelectedGame" FontSize="14" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="TxtSelectedInfo" FontSize="12"
                                       Foreground="{DynamicResource TextSecBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSelectedSize" HorizontalAlignment="Right"
                                   VerticalAlignment="Center" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Klasör Seçimi Paneli -->
            <Grid x:Name="PanelFolder" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Göndermek istediğin klasörü seç" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Klasörün tüm içeriği (alt klasörler dahil) gönderilecek"
                               FontSize="13" Foreground="{DynamicResource TextSecBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Content="📁 Klasör Seç" Style="{DynamicResource SecondaryButton}"
                            Padding="20,10" FontSize="14" HorizontalAlignment="Center"
                            Click="BtnSelectFolder_Click"/>
                    <TextBlock x:Name="TxtSelectedFolder" FontSize="13" Margin="0,16,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <!-- Exe Seçimi Paneli -->
            <Grid x:Name="PanelExe" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="64" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Uygulamanın .exe dosyasını seç" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="Exe dosyasının bulunduğu klasör otomatik olarak gönderilecek"
                               FontSize="13" Foreground="{DynamicResource TextSecBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,24"/>
                    <Button Content="⚙ Exe Seç" Style="{DynamicResource SecondaryButton}"
                            Padding="20,10" FontSize="14" HorizontalAlignment="Center"
                            Click="BtnSelectExe_Click"/>
                    <TextBlock x:Name="TxtSelectedExe" FontSize="13" Margin="0,16,0,0"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <!-- UWP uyarısı -->
                    <Border x:Name="UwpWarning" Visibility="Collapsed"
                            Background="#33FB923C" BorderBrush="#FFFB923C" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Margin="0,16,0,0" MaxWidth="480">
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFFB923C"
                                   Text="⚠ Windows Store uygulamaları (Amazon Video, Netflix vb.) aktarılamaz. Bu uygulamalar Microsoft hesabına bağlı sistem klasöründedir."/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ═══ İLERLEME ════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="3" Margin="0,16,0,16" x:Name="ProgressPanel" Visibility="Collapsed">
            <Grid Margin="0,0,0,6">
                <TextBlock x:Name="TxtTransfer" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock x:Name="TxtPct" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"/>
            </Grid>
            <ProgressBar x:Name="PbTransfer" Style="{DynamicResource ModernProgress}"
                         Value="0" Maximum="100" Margin="0,0,0,6"/>
            <Grid>
                <TextBlock x:Name="TxtSpeed" FontSize="12"
                           Foreground="{DynamicResource TextSecBrush}"/>
                <TextBlock x:Name="TxtRemaining" FontSize="12"
                           Foreground="{DynamicResource TextSecBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- ═══ BUTONLAR ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="4">
            <Button Content="Kapat" Style="{DynamicResource SecondaryButton}"
                    Width="90" HorizontalAlignment="Left"
                    Click="BtnClose_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel" Content="İptal"
                        Style="{DynamicResource DangerButton}" Width="80" Margin="0,0,10,0"
                        IsEnabled="False" Click="BtnCancelTransfer_Click"/>
                <Button x:Name="BtnSend" Content="🚀 Gönder"
                        Style="{DynamicResource PrimaryButton}" Width="130"
                        IsEnabled="False" Click="BtnSend_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
