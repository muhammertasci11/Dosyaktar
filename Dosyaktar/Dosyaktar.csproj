<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dosyaktar</AssemblyName>
    <RootNamespace>Dosyaktar</RootNamespace>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>

    <!-- Surum: her release'de artirin (2.3.0 -> 2.4.0) -->
    <Version>2.3.0</Version>
    <AssemblyVersion>2.3.0.0</AssemblyVersion>
    <FileVersion>2.3.0.0</FileVersion>
    <Product>Dosyaktar</Product>
    <Company>muhammertasci11</Company>

    <!-- Tek EXE: paylasilabilir, kurulum gerektirmez -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Hata ayiklama sembollerini EXE'ye gomme -->
    <DebugType>embedded</DebugType>
    <!-- PDB / XML / gereksiz dosyalari uretme -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <EmbeddedResource Include="Resources\strings.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>
</Project>
