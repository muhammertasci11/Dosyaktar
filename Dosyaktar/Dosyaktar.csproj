<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Dosyaktar</AssemblyName>
    <RootNamespace>Dosyaktar</RootNamespace>

    <!-- Sürüm — her release'de artırın: 1.0.0 → 1.1.0 → 1.2.0 -->
    <Version>1.5.7</Version>
    <AssemblyVersion>1.5.7.0</AssemblyVersion>
    <FileVersion>1.5.7.0</FileVersion>
    <Product>Dosyaktar</Product>
    <Company>muhammertasci11</Company>

    <!-- Tek EXE — paylaşılabilir, kurulum gerektirmez -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Hata ayıklama sembollerini EXE'ye gömme -->
    <DebugType>embedded</DebugType>
    <!-- PDB / XML / gereksiz dosyaları üretme -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

</Project>
